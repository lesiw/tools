package p

type state struct {
	limit      int
	windowSize int
}

func (s *state) windowSizeValue() int { return s.windowSize }

type device struct {
	s *state
}

func (d device) Limit() int      { return d.s.limit }
func (d device) WindowSize() int { return d.s.windowSizeValue() }

func (d device) Set(v int) {
	d.s.limit = v
}
