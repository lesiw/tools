package p

import "context"

func run(ctx context.Context, script string, a, b, c string) error {
	_, _, _, _, _ = ctx, script, a, b, c
	return nil
}

func f(ctx context.Context) error {
	return run(ctx, `
		echo one
		echo "a line of shell that reaches well past the margin"`,
		alpha, beta, gamma)
}

var alpha, beta, gamma string
