package a

func bail(xs []int) {
	// want +1 `redundant label outer`
outer:
	for _, x := range xs {
		if x < 0 {
			break outer
		}
		if x > 1 {
			break outer
		}
	}
}

func skipRest(xs []int) {
	// want +1 `redundant label again`
again:
	for _, x := range xs {
		if x < 0 {
			continue again
		}
	}
}

func preceded(xs []int) {
	// want +1 `redundant label tally`
	_ = xs; tally:
	for range xs {
		break tally
	}
}

func shared(xs []int) {
	// want +1 `redundant label scan`
	scan: for range xs {
		break scan
	}
}

func noted(xs []int) {
	// want +1 `redundant label step`
	step: /* why */ for range xs {
		break step
	}
}

func innerLoop(xs, ys []int) {
	for range xs {
		// want +1 `redundant label body`
	body:
		for range ys {
			break body
		}
	}
}

func classify(n int) {
	// want +1 `redundant label sign`
sign:
	switch {
	case n > 0:
		break sign
	}
}

func settle(ch chan int) {
	// want +1 `redundant label choice`
choice:
	select {
	case <-ch:
		break choice
	}
}

func typed(v any) {
	// want +1 `redundant label kind`
kind:
	switch v.(type) {
	default:
		break kind
	}
}

func turn(ch chan int) {
	// want +1 `redundant label round`
round:
	for {
		select {
		case <-ch:
			continue round
		}
	}
}

func throughSwitch(xs []int) {
	// want +1 `redundant label outer`
outer:
	for range xs {
		switch len(xs) {
		case 1:
			continue outer
		}
	}
}

func blank(xs []int) {
	// want +1 `redundant label _`
_:
	for range xs {
	}
}

func retry(xs []int, ready bool) {
again:
	for range xs {
		if ready {
			break again
		}
	}
	if !ready {
		goto again
	}
}

func gotoElsewhere(xs []int, ready bool) {
later:
	if !ready {
		goto later
	}
	// want +1 `redundant label whole`
whole:
	for range xs {
		break whole
	}
}

func escapingBreak(xs, ys []int) {
outer:
	for range xs {
		for range ys {
			break outer
		}
	}
}

func escapingContinue(xs, ys []int) {
outer:
	for range xs {
		for range ys {
			continue outer
		}
	}
}

func breakOutOfSelect(xs []int, ch chan bool) {
pair:
	for range xs {
		select {
		case <-ch:
			break pair
		}
	}
}

func breakOutOfSwitch(xs []int) {
pick:
	for range xs {
		switch {
		default:
			break pick
		}
	}
}

func mixed(xs, ys []int) {
both:
	for _, x := range xs {
		for range ys {
			break both
		}
		if x < 0 {
			break both
		}
	}
}
