type cell struct {
	a int
	b int
}

type row struct {
	a int
	b int
	c cell
	d []cell
	e *cell
	f *cell
}

var grid = []row{
	{0, 0, cell{4, 1}, []cell{{0, 0}, {1, 0}}, nil, nil}, // want "redundant type in slice literal" "redundant type in slice literal" "redundant type in slice literal"
}

