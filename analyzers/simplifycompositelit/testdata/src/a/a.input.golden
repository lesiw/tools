package a

type pair struct {
	x, y int
}

type code struct {
	w, z int
}

var _ = [4]pair{
	{},     // want "redundant type in array literal"
	{1, 2}, // want "redundant type in array literal"
	{3, 4}, // want "redundant type in array literal"
}

var _ = [...]pair{
	{},     // want "redundant type in array literal"
	{1, 2}, // want "redundant type in array literal"
	{3, 4}, // want "redundant type in array literal"
}

var _ = []pair{
