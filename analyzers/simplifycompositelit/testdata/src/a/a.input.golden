}{
	{}, // want "redundant type in slice literal"
	10: {1, 2}, // want "redundant type in slice literal"
	20: {3, 4}, // want "redundant type in slice literal"
}

var _ = []interface{}{
	pair{},
	10: pair{1, 2},
	20: pair{3, 4},
}

var _ = [][]int{
