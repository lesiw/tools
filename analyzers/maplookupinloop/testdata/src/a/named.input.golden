package a

type named map[string]int

func namedLookup(xs []string) {
	m := make(named)
	lookup := m["a"]
	for range xs {
		_ = lookup // want `map lookup does not depend on the loop; evaluate it once before the loop`
	}
}

func anyLookup(xs []string) {
	m := make(map[string]any)
	lookup2 := m["a"]
	for range xs {
		_ = lookup2 // want `map lookup does not depend on the loop; evaluate it once before the loop`
	}
}

type keyStruct struct {
	field string
}

func structFieldKey(m map[string]int, xs []string, k keyStruct) {
	lookup3 := m[k.field]
	for range xs {
		_ = lookup3 // want `map lookup does not depend on the loop; evaluate it once before the loop`
	}
}
