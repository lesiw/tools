func quiet(m map[string]int, xs []string, key string, f func(map[string]int, string) int) {
	for _, s := range xs {
		_ = m[s]
		_ = m[key]
		key = s
		_ = m[key]
		m = nil
		_ = m[key]
		m = map[string]int{}
		m[s] = 1
		_ = m[key]
		delete(m, s)
		clear(m)
		_ = f(m, key)
		_ = m[readKey()]
	}
	_ = m[key]
	for range []string{"a"} {
		func() {
			_ = m[key]
		}()
	}
	for k := range m {
		_ = m[k]
	}
	for i := 0; i < len(xs); i++ {
		key = xs[i]
		_ = m[key]
	}
}

