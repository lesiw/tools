package a

import "time"

func plain(m map[string]int, xs []string, key string) {
	lookup := m[key]
	for i := 0; i < len(xs); i++ {
		_ = lookup // want `map lookup does not depend on the loop; evaluate it once before the loop`
	}
}

func header(m map[string]int, xs []string) {
	for m["alpha"] > 0 {
		break
	}
	lookup2 := m["alpha"]
	for range xs {
		for lookup2 > 0 { // want `map lookup does not depend on the loop; evaluate it once before the loop`
			break
		}
	}
}

func literalLoop(m map[string]int, xs []string, key string) {
	func() {
		lookup3 := m[key]
		for range xs {
			_ = lookup3 // want `map lookup does not depend on the loop; evaluate it once before the loop`
		}
	}()
}

func packageKey(m map[time.Duration]int, xs []string) {
	lookup4 := m[time.Second]
	for range xs {
		_ = lookup4 // want `map lookup does not depend on the loop; evaluate it once before the loop`
	}
}

type labeled struct {
	field int
}

func keyedLiteral(m map[labeled]int, xs []string) {
	lookup5 := m[labeled{field: 1}]
	for range xs {
		_ = lookup5 // want `map lookup does not depend on the loop; evaluate it once before the loop`
	}
}
