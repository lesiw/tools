package a

func addOne(i int) int {
	i += 1 // want `\+= 1 can be replaced by \+\+`
	return i
}

func subtractOne(i int) int {
	i -= 1 // want `-= 1 can be replaced by --`
	return i
}

type count int

func named(c count) count {
	c += 1 // want `\+= 1 can be replaced by \+\+`
	return c
}

type tally struct {
	n int
}

func field(t *tally) {
	t.n -= 1 // want `-= 1 can be replaced by --`
}

func element(m map[string]int, k string) {
	m[k] += 1 // want `\+= 1 can be replaced by \+\+`
}

func deref(p *int) {
	*p += 1 // want `\+= 1 can be replaced by \+\+`
}

func unsigned(u uint) uint {
	u -= 1 // want `-= 1 can be replaced by --`
	return u
}

func loop(n int) {
	for i := 0; i < n; i += 1 { // want `\+= 1 can be replaced by \+\+`
	}
	for ; n > 0; n -= 1 { // want `-= 1 can be replaced by --`
	}
}

func interiorComment(i int) int {
	i += /* one */ 1 // want `\+= 1 can be replaced by \+\+`
	i -= /* one */ 1 // want `-= 1 can be replaced by --`
	return i
}

func commentBefore(i int) int {
	i /* one */ += 1 // want `\+= 1 can be replaced by \+\+`
	return i
}

func trailingComment(i int) int {
	i += 1 /* one */ // want `\+= 1 can be replaced by \+\+`
	return i
}

func wrongToken(i int) int {
	i = 1
	i *= 1
	return i
}

func notOne(i, one, n int, text string) int {
	i += 2
	i += 1.0
	i += 0x1
	i += one
	i += 1 << n
	text += "1"
	return i
}

func notInteger(f float64, c complex128) (float64, complex128) {
	f += 1
	c += 1
	return f, c
}

func generic[T ~int](x T) T {
	x += 1
	return x
}
