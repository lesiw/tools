package a

import (
	"bytes"
	"hash/maphash"
	"io"
	"strings"
)

func unlink(name string) error { return nil }

func unlinked(name string) {
	unlink(name) // want `unlink discards its error`
}

func tested(name string) {
	if unlink(name); name == "" { // want `unlink discards its error`
		return
	}
}

func switched(name string, x int) {
	switch unlink(name); x { // want `unlink discards its error`
	case 0:
	}
}

func posted(name string) {
	for i := 0; i < 1; unlink(name) { // want `unlink discards its error`
		i++
	}
}

type note struct{}

func (n note) tidy() error { return nil }

func tidied(n note) {
	n.tidy() // want `n.tidy discards its error`
}

func (n *note) seal() error { return nil }

func sealed(n *note) {
	n.seal() // want `n.seal discards its error`
}

type closer interface {
	close() error
}

func closed(c closer) {
	c.close() // want `c.close discards its error`
}

func called(f func() error) {
	f() // want `f discards its error`
}

func literal() {
	func() error { return nil }() // want `the call discards its error`
}

type fault struct{}

func (fault) Error() string { return "some message" }

func fail() *fault { return nil }

func failed() {
	fail() // want `fail discards its error`
}

func fails() fault { return fault{} }

func failing() {
	fails() // want `fails discards its error`
}

func deferredLiteral(name string) {
	defer func() {
		unlink(name) // want `unlink discards its error`
	}()
}

func parenthesized(name string) {
	(unlink(name)) // want `unlink discards its error`
	(unlink)(name) // want `unlink discards its error`
}

type sink struct{}

func (sink) WriteByte(c byte) error { return nil }

func sunk(c byte) {
	var s sink
	s.WriteByte(c) // want `s.WriteByte discards its error`
}

func written(w io.ByteWriter, c byte) {
	w.WriteByte(c) // want `w.WriteByte discards its error`
}

func generate[E error]() (zero E) { return }

func generated[E error]() {
	generate[E]() // want `generate\[E\] discards its error`
}

func term[T interface{ fault | *fault }]() (zero T) { return }

func termed[T interface{ fault | *fault }]() {
	term[T]()
}

type alias = error

func aliased() alias { return nil }

func aliasing() {
	aliased() // want `aliased discards its error`
}

func faceted() interface {
	error
	tidy()
} {
	return nil
}

func faceting() {
	faceted() // want `faceted discards its error`
}

func concretely() {
	generate[fault]() // want `generate\[fault\] discards its error`
}

func identity[T any]() (zero T) { return }

func identified[T any]() {
	identity[T]()
}

func measure() (int, error) { return 0, nil }

func measured() {
	measure()
}

func compare() (error, error) { return nil, nil }

func compared() {
	compare()
}

func announce() {}

func announced() {
	announce()
}

func count() int { return 0 }

func counted() {
	count()
}

func blanked(name string) {
	_ = unlink(name)
}

func deferred(name string) {
	defer unlink(name)
}

func launched(name string) {
	go unlink(name)
}

func checked(name string) error {
	if err := unlink(name); err != nil {
		return err
	}
	return nil
}

func built(c byte) {
	var b strings.Builder
	b.WriteByte(c)
}

func buffered(c byte) {
	var b bytes.Buffer
	b.WriteByte(c)
}

func hashed(h *maphash.Hash, c byte) {
	h.WriteByte(c)
}

func pipedWriter(w *io.PipeWriter, err error) {
	w.CloseWithError(err)
}

func pipedReader(r *io.PipeReader, err error) {
	r.CloseWithError(err)
}

func parenthesizedMethod(b *strings.Builder, c byte) {
	(b.WriteByte)(c)
}
