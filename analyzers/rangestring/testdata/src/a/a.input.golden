package a

import "unicode/utf8"

type word string

func count(s string) int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	n := utf8.RuneCountInString(s)
	return n
}

func defined(w word) int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	n := utf8.RuneCountInString(string(w))
	return n
}

func blank(s string) int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	n := utf8.RuneCountInString(s)
	return n
}

func keyBlank(s string) int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	n := utf8.RuneCountInString(s)
	return n
}

func literal() int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	n := utf8.RuneCountInString("aaaa")
	return n
}

func counterNamed(s string) int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	utf8 := utf8.RuneCountInString(s)
	return utf8
}

func counterString(w word) int {
	// want +2 `range counts runes; use utf8\.RuneCountInString`
	string := utf8.RuneCountInString(string(w))
	return string
}
