package a

import (
	"fmt"
	"os"
)

func plain(n int) {
	fmt.Fprintln(os.Stderr, "start")      // want `println can be replaced by fmt.Fprintln`
	fmt.Fprint(os.Stderr, "done")         // want `print can be replaced by fmt.Fprint`
	fmt.Fprint(os.Stderr, "n=", n, "\n")  // want `print can be replaced by fmt.Fprint`
	fmt.Fprintln(os.Stderr, n, "of", 2)   // want `println can be replaced by fmt.Fprintln`
}
