package dotaliasmixed

import "sort"

import . "foreign"

func mixed(left, right []string) {
	left = Names( /* keep */ left) // want `sort\.StringSlice is a type, so the assignment sorts nothing; write sort\.Strings\(left\)$`
	sort.Strings(right)            // want `sort\.StringSlice is a type, so the assignment sorts nothing; write sort\.Strings\(right\)$`
}
