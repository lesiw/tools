package dotdupsort

import (
	. "sort"
	stdsort "sort"
)

func dup(names []string) {
	names = StringSlice(names) // want `sort\.StringSlice is a type, so the assignment sorts nothing; write Strings\(names\)$`
}

func named(names []string) {
	names = stdsort.StringSlice(names) // want `sort\.StringSlice is a type, so the assignment sorts nothing; write stdsort\.Strings\(names\)$`
}

func keep(names []string) {
	_ = stdsort.StringSlice(names)
}
