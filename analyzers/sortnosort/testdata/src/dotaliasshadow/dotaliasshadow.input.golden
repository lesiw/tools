func keep(names []string) {
	_ = StringSlice(names)
}

func f(names []string) {
	Strings := func([]string) {}
	stdsort.Strings(names) // want `sort\.StringSlice is a type, so the assignment sorts nothing; write stdsort\.Strings\(names\)$`
