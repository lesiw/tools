package withheld

func oneLine(n int) {
	switch n { case 1: println(n); default: println(0); case 2: println(2) } // want `default clause is in the middle`
}

func headShared(n int) {
	switch n {
	case 1: println(n); default: println(0) // want `default clause is in the middle`
	case 2:
		println(2)
	}
}

func tailShared(n int) {
	switch n {
	case 1:
		println(1)
	default: // want `default clause is in the middle`
		println(0)
	case 2: println(2) }
}

func nextOnLine(n int) {
	switch n {
	case 1:
		println(1)
	default: case 2: // want `default clause is in the middle`
		println(2)
	case 3:
		println(3)
	}
}

func flushLeft(n int) {
	switch n {
	case 1:
		println(1)
// The fallback.
	default: // want `default clause is in the middle`
		println(0)
	case 2:
		println(2)
	}
}

func spacesOnly(n int) {
	switch n {
	case 1:
		println(1)
  // The fallback.
	default: // want `default clause is in the middle`
		println(0)
	case 2:
		println(2)
	}
}

func endNote(n int) int {
	switch n {
	case 1:
		return 1
	default: // want `default clause is in the middle`
		return 0
	case 2:
		return 2
	// The largest value.
	}
}

func bodyThenNext(n int) {
	switch n {
	case 1:
		println(1)
	default: // want `default clause is in the middle`
		println(0); case 2:
		println(2)
	}
}
