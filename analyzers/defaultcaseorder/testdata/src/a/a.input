func innerInDefault(a, b int) int {
	switch a {
	case 1:
		return 1
	default: // want `default clause is in the middle`
		switch b {
		case 2:
			return 2
		default: // want `default clause is in the middle`
			return 0
		case 3:
			return 3
		}
	case 4:
		return 4
	}
	return 0
}

func nested(a, b int) int {
