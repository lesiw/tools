func ready(a, b chan int) int {
	select {
	case <-a:
		return 1
	default: // want `default clause is in the middle`
		return 0
	case <-b:
		return 2
	}
}

func fallInto(n int) int {
	x := 0
	switch n {
	case 1:
		x = 1
		fallthrough
	default:
		x += 10
	case 2:
		x = 2
	}
	return x
}

func fallOutOf(n int) int {
	x := 0
	switch n {
	case 1:
		x = 1
	default:
		fallthrough
	case 2:
		x = 2
	}
	return x
}

func labeledFallthrough(n int) int {
	x := 0
	switch n {
	case 1:
		x = 1
		goto mid
	mid:
		fallthrough
	default:
		x += 10
	case 2:
		x = 2
	}
	return x
}

func labeledOutOf(n int) int {
	x := 0
	switch n {
	case 1:
		x = 1
	default:
		x += 10
		goto mid
	mid:
		fallthrough
	case 2:
		x = 2
	}
	return x
}

func threeWay(a, b int) int {
	switch {
