package a

import "other"

type box struct {
	last int
}

func array(xs [3]int) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func pointer(xs *[2]int) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func literal() (last string) {
	// want +1 `loop only keeps the last element`
	last = []string{"alpha", "bravo"}[len([]string{"alpha", "bravo"})-1]
	return last
}

func arrayLiteral() (last int) {
	// want +1 `loop only keeps the last element`
	last = [2]int{}[len([2]int{})-1]
	return last
}

func genericArray[S ~[2]int](xs S) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func dereferencedRange(xs *[2]int) (last int) {
	// want +1 `loop only keeps the last element`
	last = (*xs)[len(*xs)-1]
	return last
}

func packageTarget(xs [2]int) {
	// want +1 `loop only keeps the last element`
	other.Last = xs[len(xs)-1]
}

func fieldTarget(b box, xs [2]int) box {
	// want +1 `loop only keeps the last element`
	b.last = xs[len(xs)-1]
	return b
}

type holder struct {
	arr [2]int
}

func rangeSelector(h holder) (last int) {
	// want +1 `loop only keeps the last element`
	last = h.arr[len(h.arr)-1]
	return last
}

type rowp *[2]int

func definedPointer(xs rowp) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func packageRange() (last int) {
	// want +1 `loop only keeps the last element`
	last = other.Arr[len(other.Arr)-1]
	return last
}

func genericPointer[S ~*[2]int](xs S) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func embeddedAny[S interface {
	~[2]int
	any
}](xs S) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func embeddedComparable[S interface {
	~[2]int
	comparable
}](xs S) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

type left [2]int
type right [2]int

func namedArrayUnion[S left | right](xs S) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func labelled(xs [2]int) (last int) {
	goto L
L:
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func nested(xs, ys [2]int) (last int) {
	for _, x := range xs {
		// want +1 `loop only keeps the last element`
		last = ys[len(ys)-1]
		_ = x
	}
	return last
}

type comparableOnly interface{ comparable }

func embeddedNamed[S interface {
	~[2]int
	comparableOnly
}](xs S) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func rangeArrayTarget(last int, ys [][2]int) int {
	// want +1 `loop only keeps the last element`
	last = ys[last][len(ys[last])-1]
	return last
}

func filledIntersection[T interface {
	~[1]int | ~[2]int
	~[1]int | ~[3]int
}](xs T) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func filledIntersectionKinds[T interface {
	~[1]int | ~[0]string
	~[1]int | ~[0]int
}](xs T) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}

func comparableFilled[T interface {
	~[]int | ~[2]int
	comparable
}](xs T) (last int) {
	// want +1 `loop only keeps the last element`
	last = xs[len(xs)-1]
	return last
}
