func header(into map[string]string, counts map[string]int, m map[string]int) {
	for into["alpha"] = range m { // want `unnecessary and inefficient call of maps.Keys`
	}

	for _, counts["alpha"] = range m { // want `unnecessary and inefficient call of maps.Values`
	}
}

func field(h holder) {
	for range h.counts { // want `unnecessary and inefficient call of maps.Keys`
	}
}

func aroundCall(m map[string]int) {
	for /* name */ name := range /* over */ /* m */ m { // want `unnecessary and inefficient call of maps.Keys`
		use(name)
	}
}

func body(m map[string]int) {
	for name := range m { // want `unnecessary and inefficient call of maps.Keys`
		use(name, len(m))
	}
}

func typed(m map[string]int) {
	for name := range m { // want `unnecessary and inefficient call of maps.Keys`
		use(name)
	}
}

func partial(m map[string]int) {
	for name := range m { // want `unnecessary and inefficient call of maps.Keys`
		use(name)
	}
}

func blank(m map[string]int) {
	for _ = range m { // want `unnecessary and inefficient call of maps.Values`
	}
}

func quiet(m map[string]int, keys []string) {
	for name, count := range m {
		use(name, count)
	}
	for range keys {
		use(maps.Keys(m))
	}
}
