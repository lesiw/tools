package a

import (
	. "log"
	. "os"
)

func dotExit(n int) {
	if n == 0 {
		print(n)
	} else { // want `else does not fall through; invert the condition and outdent the then block`
		Exit(1)
	}
}

func dotFatal(n int) {
	if n == 0 {
		print(n)
	} else { // want `else does not fall through; invert the condition and outdent the then block`
		Fatal("some message")
	}
}
