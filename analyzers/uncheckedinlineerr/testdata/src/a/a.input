func apply() error { return nil }

func pair() (int, error) { return 0, nil }

func throughError[E error](item E) E { return item }

func known(error) bool { return false }

func lookup() int { return 0 }

type failure struct{}

func (*failure) Error() string { return "failed" }

func throughPointer[P *failure](item P) P { return item }

func concrete() *failure { return nil }

func empty() {
