func negative(n uint) bool {
	return n < 0 // want `uint is never negative; this is always false`
}

func notNegative(n uint8) bool {
	return n >= 0 // want `uint8 is never negative; this is always true`
}

func mirrored(n uint32) bool {
	return 0 > n // want `uint32 is never negative; this is always false`
}

func mirroredBack(n uint16) bool {
	return 0 <= n // want `uint16 is never negative; this is always true`
}

func over(n uint8) bool {
	return n > 255 // want `uint8 cannot exceed 255; this is always false`
}

func atMost(n uint8) bool {
	return n <= 255 // want `uint8 cannot exceed 255; this is always true`
}

func swapped(n uint8) bool {
	return 255 < n // want `uint8 cannot exceed 255; this is always false`
}

func swappedBack(n uint8) bool {
	return 255 >= n // want `uint8 cannot exceed 255; this is always true`
}

func widest(n uint64) bool {
	return n > 1<<64-1 // want `uint64 cannot exceed 18446744073709551615; this is always false`
}

