package a

type failure struct{}

func (failure) Error() string { return "failed" }

func load() error { return failure{} }

func loadFailure() *failure { return nil }

type item struct{ id int }

func find(first, second, third, fourth, fifth, sixth int) *item { return nil }

func findName(name string) *item { return nil }

func existing(err error) error {
	// want +1 `redundant if; write return err`
	if err != nil {
		return err
	}
	return nil
}

func reversed(err error) error {
	// want +1 `redundant if; write return err`
	if nil != err {
		return err
	}
	return nil
}

func parenthesized(err error) error {
	// want +1 `redundant if; write return err`
	if (err) != (nil) {
		return (err)
	}
	return (nil)
}

func declared() error {
	// want +1 `redundant if; write return load\(\)`
	if err := load(); err != nil {
		return err
	}
	return nil
}

func declaredReversed() error {
	// want +1 `redundant if; write return load\(\)`
	if err := load(); nil != err {
		return err
	}
	return nil
}

func literalInit() error {
	// want +1 `redundant if; write return func\(\)`
	if err := func() error { return nil }(); err != nil {
		return err
	}
	return nil
}

func collapsedInit() error {
	// want +1 `redundant if; write return load\(\)`
	if err := load(
	); err != nil {
		return err
	}
	return nil
}

func multilineLiteral() error {
	// want +1 `redundant if; write return func\(\)`
	if err := func() error {
		load()
		return load()
	}(); err != nil {
		return err
	}
	return nil
}

func named() (err error) {
	// want +1 `redundant if; write return err`
	if err != nil {
		return err
	}
	return nil
}

func pointer(p *int) *int {
	// want +1 `redundant if; write return p`
	if p != nil {
		return p
	}
	return nil
}

func typedNil(p *failure) error {
	if p != nil {
		return p
	}
	return nil
}

func typedInit() error {
	if err := loadFailure(); err != nil {
		return err
	}
	return nil
}

func equalsNil(err error) error {
	if err == nil {
		return err
	}
	return nil
}

func inSwitch(n int, err error) error {
	switch n {
	case 1:
		// want +1 `redundant if; write return err`
		if err != nil {
			return err
		}
		return nil
	}
	return nil
}

func inSelect(ch chan error) error {
	select {
	case err := <-ch:
		// want +1 `redundant if; write return err`
		if err != nil {
			return err
		}
		return nil
	}
	return nil
}

func inBlock(err error) error {
	{
		// want +1 `redundant if; write return err`
		if err != nil {
			return err
		}
		return nil
	}
}

func inLiteral(err error) error {
	inner := func(inner error) error {
		// want +1 `redundant if; write return inner`
		if inner != nil {
			return inner
		}
		return nil
	}
	return inner(err)
}

func commentBefore(err error) error {
	// the load may fail
	// want +1 `redundant if; write return err`
	if err != nil {
		return err
	}
	return nil
}

func trailingComment(err error) error {
	// want +1 `redundant if; write return err`
	if err != nil {
		return err
	}
	return nil // keep
}

func trailingWide(err error) error {
	// want +1 `redundant if`
	if err != nil {
		return err
	}
	return nil // this comment is long enough to push the replacement over the line
}

func commentInside(err error) error {
	// want +1 `redundant if; write return err`
	if err != nil {
		// the load failed
		return err
	}
	return nil
}

func commentBetween(err error) error {
	// want +1 `redundant if; write return err`
	if err != nil {
		return err
	}
	// the load succeeded
