}

func headerComment(err error) error {
	// want +1 `redundant if; write return err`
	if err != nil /* the load failed */ {
		return err
	}
	return nil
}

func tailComment(err error) error {
	// want +1 `redundant if; write return err`
	if err != nil {
		return err
	} // the load succeeded
	return nil
}

func wide() *item {
	// want +1 `redundant if; write return find\(`
	if p := find(
		111111111,
		222222222,
		333333333,
		444444444,
		555555555,
		666666666,
	); p != nil {
		return p
	}
	return nil
}

func raw() *item {
	// want +1 `redundant if$`
	if p := findName(`alpha
beta`); p != nil {
		return p
	}
	return nil
}

func notAdjacent(err error) error {
	if err != nil {
		return err
	}
	println("done")
	return nil
}

func bodyWork(err error) error {
	if err != nil {
		println("failed")
		return err
	}
	return nil
}

func elseBranch(err error) error {
	if err != nil {
		return err
	} else {
		return nil
	}
}

func otherReturn(err, other error) error {
	if err != nil {
		return other
	}
	return nil
}

func otherTail(err, other error) error {
	if err != nil {
		return err
	}
	return other
}

func assignment(err error) error {
	if err = load(); err != nil {
		return err
	}
	return nil
}

func paired() (int, error) {
	if n, err := pair(); err != nil {
		return n, err
	}
	return 0, nil
}

func twoNames() error {
	if _, err := pair(); err != nil {
		return err
	}
	return nil
}

func pair() (int, error) { return 0, nil }

func twoResults(err error) (int, error) {
