package a

type mutex struct{}

func (mutex) Lock()          {}
func (mutex) TryLock() bool  { return true }
func (mutex) Unlock()        {}
func (mutex) RLock()         {}
func (mutex) TryRLock() bool { return true }
func (mutex) RUnlock()       {}

func bareUnlock(m mutex) {
	defer m.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func bareRUnlock(m mutex) {
	defer m.RUnlock() // want `deferred RUnlock has no matching RLock in this function`
}

func locked(m mutex) {
	m.Lock()
	defer m.Unlock()
}

func readLocked(m mutex) {
	m.RLock()
	defer m.RUnlock()
}

func lockAfter(m mutex) {
	defer m.Unlock()
	m.Lock()
}

func branchLock(m mutex, ok bool) {
	if ok {
		m.Lock()
	}
	defer m.Unlock()
}

