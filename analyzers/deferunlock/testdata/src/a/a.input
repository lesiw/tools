func getMutex() mutex { return mutex{} }

func findMutex() (*mutex, int) { return &mutex{}, 0 }

func getStore() store { return store{} }

func getStorePtr() *store { return &store{} }

func getStores() []store { return nil }

func getAny() any { return mutex{} }

func fromCall() {
	m := getMutex()
	defer m.Unlock()
}

func fromMultiValue() {
	m, _ := findMutex()
	defer m.Unlock()
}

func fromCallField() {
	s := getStore()
	defer s.mu.Unlock()
}

func fromCallDirect() {
	defer getMutex().Unlock()
}

func fromCallFieldDirect() {
	defer getStore().mu.Unlock()
}

func fromCallIndexDirect() {
	defer getStores()[0].mu.Unlock()
}

func fromCallDeref() {
	defer (*getStorePtr()).mu.Unlock()
}

func fromCallTypeAssert() {
	defer getAny().(interface{ Unlock() }).Unlock()
}

func fromConversion() {
	defer mutex(getMutex()).Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func fromFieldAssignment() {
	var s store
	s.mu = getMutex()
	defer s.mu.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func fromIndexAssignment() {
	xs := make([]mutex, 1)
	xs[0] = getMutex()
	defer xs[0].Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func fromAppend(xs []mutex) {
	xs = append(xs, mutex{})
	defer xs[0].Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func postAssignment() {
	m := mutex{}
	for i := 0; i < 1; m = getMutex() {
		m = mutex{}
		i++
	}
	defer m.Unlock()
}

func fromAlias() {
	m := getMutex()
	n := m
	defer n.Unlock()
}

func fromRange() {
	for _, s := range getStores() {
		defer s.mu.Unlock()
	}
}

func fromRangeParam(stores []store) {
	for _, s := range stores {
