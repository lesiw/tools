}

func tryLockConverted(m mutex) {
	_ = bool(m.TryLock())
	defer m.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func tryLockOr(m mutex) {
	_ = m.TryLock() || true
	defer m.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func tryLockSlice(m mutex) {
	_ = []bool{m.TryLock()}[0]
	defer m.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func tryLockMapKey(m mutex) {
	_ = map[bool]bool{m.TryLock(): true}
	defer m.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func tryReadLock(m mutex) {
	m.TryRLock()
	defer m.RUnlock() // want `deferred RUnlock has no matching RLock in this function`
}

func tryLockGuard(m mutex) {
	if !m.TryLock() {
		return
	}
	defer m.Unlock()
}

func tryLockChecked(m mutex) {
	ok := m.TryLock()
	if !ok {
		return
	}
	defer m.Unlock()
}

func tryLockUnchecked(m mutex) {
	ok := m.TryLock()
	_ = ok
	defer m.Unlock()
}

func consume(any) {}

func fromDeferArg(m mutex) {
	defer consume(m.TryLock())
	defer m.Unlock()
}

func fromGoArg(m mutex) {
	go consume(m.TryLock())
	defer m.Unlock()
}

func tryReadLockGuard(m mutex) {
	if !m.TryRLock() {
		return
	}
	defer m.RUnlock()
}

