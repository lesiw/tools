type store struct {
	mu    mutex
	other mutex
}

func (s *store) lockedField() {
	s.mu.Lock()
	defer s.mu.Unlock()
}

func (s *store) bareField() {
	defer s.mu.Unlock() // want `deferred Unlock has no matching Lock in this function`
}

func (s *store) otherField() {
