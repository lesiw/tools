package a

import "net/http"

const tag = "x-tag"
const other = "x-other"

func noImport(h alias) {
	h[http.CanonicalHeaderKey(tag)] = nil   // want `header key "x-tag" is not canonical`
	_ = h[http.CanonicalHeaderKey(tag)]     // want `header key "x-tag" is not canonical`
	h[http.CanonicalHeaderKey(other)] = nil // want `header key "x-other" is not canonical`
}
