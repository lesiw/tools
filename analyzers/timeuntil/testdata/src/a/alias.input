package a

import tm "time"

func aliased(deadline tm.Time, wait tm.Duration) bool {
	return tm.Now().Add(wait).Before(deadline) // want `comparison can be replaced by tm\.Until\(deadline\) > wait`
}

func pointedAlias(p *tm.Time, wait tm.Duration) bool {
	return p.After(tm.Now().Add(wait)) // want `comparison can be replaced by tm\.Until\(\*p\) > wait`
}

func aliasedSince(deadline tm.Time) bool {
	return deadline.After(tm.Now().Add(-tm.Minute)) // want `comparison can be replaced by tm\.Since\(deadline\) < tm\.Minute`
}
