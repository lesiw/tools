package a

import (
	"context"
	"fmt"
	"io"
	"log"
	"os"
	"runtime/trace"
	"testing"
)

func formatted(s string) {
	fmt.Printf(s)             // want `format string is not constant; use Print`
	(fmt.Printf)(s)           // want `format string is not constant; use Print`
	_ = fmt.Sprintf(s)        // want `format string is not constant; use Sprint`
	fmt.Fprintf(os.Stderr, s) // want `format string is not constant; use Fprint`
	fmt.Fprintf(os.Stderr, s, "value")
	fmt.Appendf(nil, s) // want `format string is not constant; use Append`
	fmt.Appendf(nil, s, "value")
	fmt.Printf(s + "!") // want `format string is not constant; use Print`
	fmt.Printf("%s", s)
	fmt.Printf(s, "value")
	fmt.Printf("some greeting")
	fmt.Printf(greeting)
	fmt.Printf("some" + " greeting")
	fmt.Printf(build()) // want `format string is not constant; use Print`
	fmt.Printf(pair())
	_ = fmt.Sprintf(pair())
	fmt.Fprintf(pairWriter()) // want `format string is not constant; use Fprint`
	fmt.Fprintf(pairWriterArgument())
	fmt.Appendf(pairBuffer()) // want `format string is not constant; use Append`
	fmt.Appendf(pairBufferArgument())
	fmt.Errorf(s)
}

func logged(s string) {
	log.Printf(s) // want `format string is not constant; use Print`
	log.Fatalf(s) // want `format string is not constant; use Fatal`
	log.Panicf(s) // want `format string is not constant; use Panic`
	sink := log.New(os.Stderr, "some: ", log.LstdFlags)
	sink.Printf(s) // want `format string is not constant; use Print`
	sink.Fatalf(s) // want `format string is not constant; use Fatal`
	sink.Panicf(s) // want `format string is not constant; use Panic`
	sink.Printf(pair())
	log.Printf("%s", s)
	log.Printf(s, "value")
	logLine := log.Printf
	logLine(s)
}

type embeddedLogger struct{ *log.Logger }

func (l *embeddedLogger) promoted(s string) {
	l.Printf(s) // want `format string is not constant; use Print`
}

func methodExpression(l *log.Logger, s string) {
	(*log.Logger).Printf(l, s) // want `format string is not constant; use Print`
	(*log.Logger).Fatalf(l, s) // want `format string is not constant; use Fatal`
	(*log.Logger).Printf(l, s, "value")
}

func (l *embeddedLogger) promotedExpression(s string) {
	(*embeddedLogger).Printf(l, s) // want `format string is not constant; use Print`
}

func methodExpressionTuple() {
	(*log.Logger).Printf(pairLogger()) // want `format string is not constant; use Print`
	(*log.Logger).Printf(pairLoggerArgument())
}

func multiline(s string) {
	fmt.Printf( // want `format string is not constant; use Print`
		s,
	)
}

func traced(s string) {
	trace.Logf(context.Background(), "some", s)
}

type formatter interface{ Printf(string) }

func interfaced(f formatter, s string) {
	f.Printf(s)
}

type shadowedLogger struct{ *log.Logger }

func (shadowedLogger) Print(...any) {}

func (l *shadowedLogger) shadowed(s string) {
	l.Printf(s)
	(*shadowedLogger).Printf(l, s)
}

func tested(t *testing.T, b *testing.B, f *testing.F, tb testing.TB, s string) {
	t.Errorf(s)
	t.Fatalf(s)
	t.Logf(s)
	t.Skipf(s)
	b.Errorf(s)
	b.Fatalf(s)
	b.Logf(s)
	b.Skipf(s)
	f.Errorf(s)
	f.Fatalf(s)
	f.Logf(s)
	f.Skipf(s)
	tb.Errorf(s)
	tb.Fatalf(s)
	tb.Logf(s)
	tb.Skipf(s)
}

const greeting = "some greeting"

func build() string { return "%s" }

func pair() (string, int) { return "%s", 1 }

func pairWriter() (io.Writer, string) { return os.Stderr, "%s" }

func pairBuffer() ([]byte, string) { return nil, "%s" }

func pairWriterArgument() (io.Writer, string, int) { return os.Stderr, "%s", 1 }

func pairBufferArgument() ([]byte, string, int) { return nil, "%s", 1 }

func pairLogger() (*log.Logger, string) { return nil, "%s" }

func pairLoggerArgument() (*log.Logger, string, int) { return nil, "%s", 1 }
