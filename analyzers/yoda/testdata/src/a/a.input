package a

func f(err error) bool {
	return nil == err // want `constant on the left`
}

func g(n int) bool {
	return 0 == n // want `constant on the left`
}

func h(s string) bool {
	return "x" != s // want `constant on the left`
}

func ok(err error) bool {
	return err == nil
}

func both() bool {
	return 1 == 1
}

func ordered(n int) bool {
	return 0 < n
}
