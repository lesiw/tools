package a

import (
	"fmt"
	"log"
	"testing"
)

type texts []byte

func (*texts) String() string { return "" }

type stringed []byte

func (stringed) String() string { return "" }

type failed []byte

func (failed) Error() string { return "" }

type formatted []byte

func (formatted) Format(fmt.State, rune) {}

type mismatched []byte

func (mismatched) Format(n int, verb rune) {}

type sink []byte

func (sink) Write(p []byte) (int, error) { return len(p), nil }

func defaults(b []byte, s string) {
	fmt.Print(string(b), s)         // want `formats as a list of numbers`
	fmt.Println(s, string(b))       // want `formats as a list of numbers`
	fmt.Fprint(nil, string(b))      // want `formats as a list of numbers`
	fmt.Fprintln(nil, s, string(b)) // want `formats as a list of numbers`
	fmt.Sprint(string(b))           // want `formats as a list of numbers`
	fmt.Sprintln(string(b))         // want `formats as a list of numbers`
}

func logged(l *log.Logger, b []byte) {
	log.Print(string(b))   // want `formats as a list of numbers`
	log.Println(string(b)) // want `formats as a list of numbers`
	log.Fatal(string(b))   // want `formats as a list of numbers`
	log.Fatalln(string(b)) // want `formats as a list of numbers`
	log.Panic(string(b))   // want `formats as a list of numbers`
	log.Panicln(string(b)) // want `formats as a list of numbers`
	l.Print(string(b))     // want `formats as a list of numbers`
	l.Println(string(b))   // want `formats as a list of numbers`
	l.Fatal(string(b))     // want `formats as a list of numbers`
	l.Fatalln(string(b))   // want `formats as a list of numbers`
	l.Panic(string(b))     // want `formats as a list of numbers`
	l.Panicln(string(b))   // want `formats as a list of numbers`
}

func recorded(t *testing.T, bench *testing.B, f *testing.F, tb testing.TB, src []byte) {
	t.Error(string(src))               // want `formats as a list of numbers`
	t.Log(string(src))                 // want `formats as a list of numbers`
	t.Fatal(string(src))               // want `formats as a list of numbers`
	t.Skip(string(src))                // want `formats as a list of numbers`
	bench.Error(string(src))           // want `formats as a list of numbers`
	f.Skip(string(src))                // want `formats as a list of numbers`
	tb.Log(string(src))                // want `formats as a list of numbers`
	(*testing.T).Error(t, string(src)) // want `formats as a list of numbers`
}

type recorder struct{ *log.Logger }

type hidden struct{ *log.Logger }

func (hidden) Print(...any) {}

type ownTest struct{ *testing.T }

func (ownTest) Log(...any) {}

func embedded(r recorder, h hidden, o ownTest, l *log.Logger, b []byte) {
	r.Print(string(b))   // want `formats as a list of numbers`
	h.Println(string(b)) // want `formats as a list of numbers`
	h.Print(b)
	o.Log(b)
	o.Error(string(b))                // want `formats as a list of numbers`
	(*log.Logger).Print(l, string(b)) // want `formats as a list of numbers`
}

func named() {
	type element = byte
	type digit byte
	type grouped []element
	type digits []digit
	type copied = texts
	fmt.Print(string(grouped{})) // want `formats as a list of numbers`
	fmt.Print(string(digits{}))  // want `formats as a list of numbers`
	fmt.Print(string(copied{}))  // want `formats as a list of numbers`
}

func writes(s sink, b []byte) {
	fmt.Fprint(s, string(b)) // want `formats as a list of numbers`
}

func pointers(t texts, p *texts) {
	fmt.Print(string(t)) // want `formats as a list of numbers`
	fmt.Print(p)
}

func silent(v stringed, e failed, f formatted) {
	fmt.Print(v, e, f)
	fmt.Println(v)
}

func shaped(m mismatched) {
	fmt.Print(string(m)) // want `formats as a list of numbers`
}

func shadowed(b []byte) {
	string := len(b)
	fmt.Print(b) // want `formats as a list of numbers`
	_ = string
}

func others(xs []int, rs []rune, s string) {
	fmt.Print(xs, rs, s)
}

func elsewhere(b []byte) {
	fmt.Printf("%s", b)
	fmt.Errorf("%s", b)
	fmt.Sprint(string(b))
	fmt.Print(pair())
	fmt.Print(string(b[:])) // want `formats as a list of numbers`
	fmt.Print(string((b)))  // want `formats as a list of numbers`
}

func pair() ([]byte, int) { return nil, 0 }

func generic[T ~[]byte](src T) {
	fmt.Print(src)
}
