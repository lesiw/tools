package a

import (
	"bytes"
	"fmt"
)

func f(b *bytes.Buffer, w *bytes.Buffer, n int) {
	fmt.Fprintf(b, "%d", n) // want `formatted string written to a writer`
	fmt.Fprintf(b, "%d", n) // want `formatted string written to a writer`
	fmt.Fprint(w, n)        // want `formatted string written to a writer`
	fmt.Fprintln(b, n)      // want `formatted string written to a writer`
}

func ok(b *bytes.Buffer, n int) {
	fmt.Fprintf(b, "%d", n)
}

func plain(b *bytes.Buffer, s string) {
	b.Write([]byte(s))
}

type fakefmt struct{}

func (fakefmt) Sprintf(...any) string { return "" }

func shadow(b *bytes.Buffer) {
	var fmt fakefmt
	b.WriteString(fmt.Sprintf())
}
