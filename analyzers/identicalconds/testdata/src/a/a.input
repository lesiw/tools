type counter struct{ n int }

func (c *counter) step() bool {
	c.n++
	return false
}

func afterCall(c *counter) int {
	if c.n > 0 {
		return 1
	} else if c.step() {
		return 2
	} else if c.n > 0 {
		return 3
	}
	return 0
}

