package a

type flag bool

func compared(b bool) bool {
	if b { // want `comparison with true; write the operand`
		return true
	}
	if b { // want `comparison with false; write the operand`
		return true
	}
	if b { // want `comparison with true; write the operand`
		return true
	}
	if b { // want `comparison with false; write the operand`
		return true
	}
	if b { // want `comparison with true; write the operand`
		return true
	}
	for b { // want `comparison with true; write the operand`
		return true
	}
	switch {
	case b: // want `comparison with false; write the operand`
		return true
	}
	switch b {
	case b: // want `comparison with true; write the operand`
	}
	return false
