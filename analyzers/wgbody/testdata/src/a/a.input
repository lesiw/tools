func recoverIf(wg *sync.WaitGroup) {
	wg.Go(func() {
		defer func() {
			if err := recover(); err != nil {
				_ = err
			}
		}()
		panic("some message")
	})
}

func recoverSwitch(wg *sync.WaitGroup) {
	wg.Go(func() {
		defer func() {
