func fakeRecover(wg *sync.WaitGroup) {
	wg.Go(func() {
		defer func() {
			go func() { _ = recover() }()
			nested := func() { _ = recover() }
			_ = nested
		}()
		panic("some message") // want `panic inside a WaitGroup\.Go body, which must not panic`
	})
}

