package a

import "strings"

func f(s string) []string {
	return strings.Fields(s)
}

func use(fn func(string) []string) {}

func g() {
	use(strings.Fields) // want `literal only forwards its arguments`
	use(strings.Fields)
}

func h() {
	use(func(s string) []string { return strings.Fields(strings.TrimSpace(s)) })
}

func i() {
	use(func(s string) []string { return strings.Split(s, " ") })
}

func j() {
	use(func(s string) []string {
		s = strings.TrimSpace(s)
		return strings.Fields(s)
	})
}

type coll interface{ Len() int }

func newBuiltin(size int) *builtin { return &builtin{size} }

type builtin struct{ size int }

func (b *builtin) Len() int { return b.size }

func useColl(fn func(int) coll) {}

func k() {
	useColl(func(size int) coll { return newBuiltin(size) })
}
