}

func nestedContinue(xs []int) int {
	// want +1 `loop runs at most once`
	for _, x := range xs {
		for _, y := range xs {
			if y == 0 {
				continue
			}
		}
		return x
	}
	return 0
}

func labeledOuter(xs []int) int {
outer:
	for _, x := range xs {
		// want +1 `loop runs at most once`
		for _, y := range xs {
			if y != x {
				continue outer
			}
			return y
		}
	}
	return 0
}

func typed(v any) int {
	// want +1 `loop runs at most once`
	for {
		switch v.(type) {
		case int:
			use(v)
		}
		return 0
	}
}

func selected(ch chan int) int {
	// want +1 `loop runs at most once`
	for {
		select {
		case v := <-ch:
			use(v)
		default:
			use(0)
		}
		return 0
	}
}

func nestedLoop(xs []int) int {
	// want +1 `loop runs at most once`
	for {
		for _, x := range xs {
