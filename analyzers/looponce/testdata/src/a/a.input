	}
}

func breaking(xs []int) int {
	// want +1 `loop runs at most once`
	for {
		if len(xs) == 0 {
			break
		}
		return xs[0]
	}
	return 0
}

func initOnly(n int) int {
	// want +1 `loop runs at most once`
	for i := 0; ; {
		if i == n {
			return i
		}
		return 0
	}
}

func literal(n int) int {
	// want +1 `loop runs at most once`
	for {
		f := func() {
			for {
				if n > 0 {
					continue
				}
				break
			}
			goto done
		done:
			return
		}
		f() // keep
		if n > 0 {
			return n
		}
		return 0
	}
}

func nestedBreak(xs []int) int {
	// want +1 `loop runs at most once`
	for {
		for _, x := range xs {
			if x == 0 {
				break
			}
		}
		if len(xs) == 0 {
			return 0
		}
		return xs[0]
	}
}

