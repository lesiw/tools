package a

func use(...any) {}

func choose(xs []int) int {
	// want +1 `loop runs at most once`
	for _, x := range xs {
		if x > 0 {
			return x
		}
		return 0
	}
	return -1
}

func countdown(n int) int {
	// want +1 `loop runs at most once`
	for i := 0; i < n; i++ {
		if i == n-1 {
			return i
		}
		return n
	}
	return 0
}

func stop(n int) {
	// want +1 `loop runs at most once`
	for i := 0; i < n; i++ {
		if i > 0 {
			use(i)
		}
		break
	}
}

func endless(xs []int) int {
	// want +1 `loop runs at most once`
	for {
		if len(xs) == 0 {
			return 0
		}
		return xs[0]
	}
}

func stringFirst(s string) rune {
	// want +1 `loop runs at most once`
	for _, r := range s {
		if r == 'a' {
			return r
		}
		return 'b'
	}
	return 0
}

func arrayFirst(a [2]int) int {
	// want +1 `loop runs at most once`
	for _, x := range a {
		if x > 0 {
			return x
		}
		return 0
	}
