		return 0
	}
}

func waiting(n int) int {
	// want +1 `loop runs at most once`
	for n > 0 {
		if n == 1 {
			return 1
		}
		return 0
	}
	return -1
}

func commentedLoop(n int) int {
	// want +1 `loop runs at most once`
	for {
		if n > 0 {
