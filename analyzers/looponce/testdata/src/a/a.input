}

func selectBreak(ch chan int) int {
	// want +1 `loop runs at most once`
	for {
		select {
		case v := <-ch:
			use(v)
			break
		default:
			use(0)
			break
		}
		if n := len(ch); n > 0 {
			return n
		}
		return 0
	}
}

