	}
	return n // want `return is unreachable after a loop that cannot complete normally`
}

func breakSwitch(n int) int {
sw:
	switch {
	case n > 0:
		for {
			break sw
		}
		return 1 // want `return is unreachable after a loop that cannot complete normally`
	}
	return n
}

func breakSelect(ch chan int) int {
sel:
	select {
	case <-ch:
		for {
			break sel
		}
		return 1 // want `return is unreachable after a loop that cannot complete normally`
	}
	return 0
}

func gotoPastReturn() int {
	for {
		goto done
	}
	return 1 // want `return is unreachable after a loop that cannot complete normally`
done:
	return 2
}

func backwardGoto() int {
loop:
	for {
		goto loop
	}
	return 1 // want `return is unreachable after a loop that cannot complete normally`
}

func breakOuter() {
outer:
	for {
		for {
			break outer
		}
		return // want `return is unreachable after a loop that cannot complete normally`
	}
