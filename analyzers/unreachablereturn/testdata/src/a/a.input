func conditionalPanic(n int) int {
	if n < 0 {
		panic("some message")
	}
	return n
}

func panicInIf(n int) {
	if n > 0 {
		panic("some message")
		return // want `return is unreachable after a panic`
	}
}

func conditionalLoop(n int) int {
	for n > 0 {
		n--
	}
	return n
}

