func withGoto() int {
	for {
		goto done
	}
done:
	return 1
}

func gotoAfterPanic(n int) int {
	if n > 0 {
		goto done
	}
	panic("some message")
done:
	return n
}

func gotoSkipsPanic(n int) int {
	if n > 0 {
		goto done
	}
	panic("some message")
done:
	println(n)
	return n
}

func gotoAfterPanicTarget() {
	panic("some message")
	goto done
done:
	return
}

func gotoFromBreakableLoop(n int) int {
	for n > 0 {
		goto done
	}
	return n
done:
	return 0
}

func gotoBetweenLoopAndReturn(n int) int {
	if n > 0 {
		goto middle
	}
	for {
		goto done
	}
middle:
	println(n)
	return 1
done:
	return 2
}

func gotoLabelThenPanic(n int) int {
	if n > 0 {
		goto done
	}
done:
	panic("some message")
	return n // want `return is unreachable after a panic`
}

func gotoLabelThenLoop(n int) int {
	if n > 0 {
		goto done
	}
done:
