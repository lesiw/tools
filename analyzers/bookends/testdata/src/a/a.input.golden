func nestedPack(w io.Writer, found int, desc, text string) {
	fmt.Fprintf(
		w, "--- %d %s\n%s\n---\n", found, desc,
		strings.Join(strings.Fields(text), "\n"),
	) // want `elements fit on 2 lines`
}

