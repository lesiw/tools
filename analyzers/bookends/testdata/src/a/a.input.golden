func balanced(w http.ResponseWriter, err error) {
	registerFiveLongArgs( // want `elements fit on 3 lines`
		pad("aaaaaaaaaaaaaaaaaaaa"),
		pad("bbbbbbbbbbbbbbbbbbbb"), pad("cccccccccccccccccccc"),
		pad("dddddddddddddddddddd"), pad("eeeeeeeeeeeeeeeeeeee"),
	)
}

func orphan(w http.ResponseWriter, err error) {
	registerThreeLongArgs( // want `elements fit on 2 lines`
		wrap(alphaAlphaAlphaAlphaAlphaAlphaAlphaAlphaAlphaAlphaAlphaAlpha),
		wrap(beta), wrap(gamma),
	)
}

