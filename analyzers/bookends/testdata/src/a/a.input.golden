func splitByWidth(w http.ResponseWriter, err error) {
	registerFourArgsWithString( // want `elements fit on 2 lines`
		w, http.StatusNotFound,
		"some-kind", err.Error(),
	)
}

func grouped(w http.ResponseWriter, err error) {
	registerFourArgsWithString(w, http.StatusNotFound,
		"some-kind",
		err.Error(),
	)
}

func keyedArgs(log *slog.Logger, item item, err error) {
	log.Warn( // want `each key and its value take a line`
		"fetch failed",
		"id", item.ID,
		"kind", item.Kind,
		"err", err,
	)
}

func longLiteral(w http.ResponseWriter, err error) {
	registerLongArgs(
		w, http.StatusNotFound,
		"some-kind", // want `elements fit on 3 lines`
		struct{ A, B string }{"a", "b"},
	)
}

func registerLongArgs(w http.ResponseWriter, status int, msg string, v any) {}

func nestedLists(w http.ResponseWriter, err error) {
	registerLongArgs(
		w, http.StatusNotFound, "some-kind", inner( // want `elements fit on 2 lines`
			"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
		),
	)
}

func trailingComments() {
	registerThreeStrings(
		"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
		"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", /* one */ /* two */
		"cccc",
	) // want `elements fit on 3 lines`
}

func pullUp() {
	registerFunc(func() { // want `element fits on the opener's line`
		registerThreeStrings("aaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
		registerThreeStrings("bbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
	})
}

func registerFunc(fn func()) {}

