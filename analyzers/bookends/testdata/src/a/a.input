package a

type pair struct {
	a int
	b int
}

var table = []pair{ // want `table mixes one-line and multi-line rows`
	{1, 2},
	{3,
		4},
}

var nested = map[string][]int{
	"a": {1, // want `opening bracket shares a line with its first element`
		2,
	},
}

func f(ps []pair, a, b int, values map[string]int, keys []string) []pair {
	ps = append(ps, pair{a: a,
		b: values[keys[0]]}) // want `closer is not at the indent of its opener`
	return ps
}

func call(g func(int, int) int) int {
	return g(
		1,
		2,
	)
}

type list[T, U any] struct{}

func instantiate[T, U any]() list[
	T, U] { // want `closer is not at the indent of its opener`
	return list[T, U]{}
}

func spread(xs []int) []int {
	return append(xs,
		xs...) // want `closer is not at the indent of its opener`
}

func indented(g func(int, int) int) int {
	return g(1,
		2,
		)
}

func comment(g func(int, int) int) int {
	return g(1,
		2 /* why */) // want `closer is not at the indent of its opener`
}

type row struct {
	first, second, third, fourth, fifth, sixth, seventh, eighth int
}

// wideTable puts the first row on the opener's line and the second across
// lines. Measuring the first row appends to its indent, and that indent is
// the line the table starts on, so a fix that builds the line on the source's
// own bytes corrupts the text it is about to write.
var wideTable = []row{{1, 2, 3, 4, 5, 6, 7, 8}, { // want `table mixes one-line and multi-line rows`
	1, 2, 3, 4, 5, 6, 7, 8,
}}
