package a

type count int

var key int

var value int

func stringLoop(s string) int {
	n := 0
	for range s { n++ }
	return n
}

func mapLoop(m map[int]int) int {
	n := 0
	for range m { n++ }
	return n
}

func arrayLoop(xs [4]int) int {
	n := 0
	for range xs { n++ }
	return n
}

func channelLoop(ch chan int) int {
	n := 0
	for range ch { n++ }
	return n
}

func integerLoop() int {
	n := 0
	for range 4 { n++ }
	return n
}

func extraStatement(xs []int) int {
	n := 0
	for range xs {
		n++
		use(n)
	}
	return n
}

func emptyBody(xs []int) int {
	n := 0
	for range xs {}
	return n
}

func decrement(xs []int) int {
	n := 0
	for range xs { n-- }
	return n
}

func compound(xs []int) int {
	n := 0
	for range xs { n += 1 }
	return n
}

func nonzero(xs []int) int {
	n := 1
	for range xs { n++ }
	return n
}

func separated(xs []int) int {
	n := 0
	m := 1
	for range xs { n++ }
	return n + m
}

func assignedKey(xs []int) int {
	n := 0
	for key = range xs { n++ }
	return n
}

func notZeroedBefore(xs []int) int {
	var n int
	n = 1
	for range xs { n++ }
	return n
}

func wrongType(xs []int) int64 {
	var n int64
	for range xs { n++ }
	return n
}

func namedType(xs []int) count {
	var n count
	for range xs { n++ }
	return n
}

func fromOne(xs []int) int {
	n := 0
	for i := 1; i < len(xs); i++ { n++ }
	return n
}

func inclusive(xs []int) int {
	n := 0
	for i := 0; i <= len(xs)-1; i++ { n++ }
	return n
}

func fixedBound(xs []int) int {
	n := 0
	for i := 0; i < 4; i++ { n++ }
	return n
}

func step(xs []int) int {
	n := 0
	for i := 0; i < len(xs); i += 2 { n++ }
	return n
}

func indexBound(xs []int) int {
	n := 0
	for i := 0; i < len(xs[i:]); i++ { n++ }
	return n
}

func callBound(xs []int) int {
	n := 0
	for i := 0; i < len(copies(xs)); i++ { n++ }
	return n
}

func shadowedLen(xs []int) int {
	len := func([]int) int { return 0 }
	n := 0
	for range xs { n++ }
	return n + len(xs)
}

func counterLen(xs []int) int {
	len := 0
	for range xs { len++ }
	return len
}

func duplicateWrite(xs []int) int {
	n := 0
	n, n = 0, 1
	for range xs { n++ }
	return n
}

func pointerWrite(xs []int) int {
	n := 0
	xs[0], n = 0, 0
	for range xs { n++ }
	return n
}

func pointerBound(xs []int) int {
	n := 5
	p := &n
	n = 0
	for i := 0; i < len(xs[*p:]); i++ { n++ }
	return n
}

func counterBound(xs []int) int {
	n := 0
	for i := 0; i < len(xs[n:]); i++ { n++ }
	return n
}

func receiveLoop(ch chan []int) int {
	n := 0
	for range <-ch { n++ }
	return n
}

func literalLoop() int {
	n := 0
	for range (&[2]int{})[:] { n++ }
	return n
}

func functionLoop(seq func(func(int) bool)) int {
	n := 0
	for range seq { n++ }
	return n
}

func typeParameter[S ~[]int](xs S) int {
	n := 0
	for range xs { n++ }
	return n
}

func assignedValue(xs []int) int {
	n := 0
	for _, value = range xs { n++ }
	return n
}

func rangeCall(xs []int) int {
	n := 0
	for range copies(xs) { n++ }
	return n
}

func sharedIndex(xs []int) int {
	n := 0
	for n := 0; n < len(xs); n++ { n++ }
	return n
}

func labeled(xs []int) int {
	n := 0
Loop:
	for range xs { n++ }
	if n < 0 { goto Loop }
	return n
}

func use(int) {}

func copies(xs []int) []int { return xs }
