func callWithASignaturePastTheLimit(s string, n int, fn func(string) error) {}

func literalSignature() {
	_ = func(someLongParameterNameThatPushesEvenFurtherPastTheLimit string, anotherLongParameterNameThatPushesPastTheLimit bool) error {
		return nil
	}
	callWithASignaturePastTheLimit("alpha-argument-name-that-is-longer-here", 2, func(someLongParameterNameThatPushesPastTheLimit string) error { // want "line is .* characters long, exceeds 79 limit"
		return nil
	})
