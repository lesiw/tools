package a

func f(n int) int {
	switch n {
	case 0:
		fallthrough // want `case only falls through`
	case 1:
		return 1
	}
	return 0
}

func ok(n int) int {
	switch n {
	case 0, 1:
		return 1
	}
	return 0
}

func g(n int) int {
	switch n {
	case 0:
		println("zero")
		fallthrough
	case 1:
		return 1
	}
	return 0
}

func h(n int) int {
	switch n {
	case 0:
		fallthrough
	default:
		return 1
	}
}
