package a

import . "io"

func dottedMixed(w *writer, b []byte) error {
	_, err := WriteString(w, string(b)) // want `byte slice converted to a string for io\.WriteString`
	_, err = WriteString(w, string([]byte{1, 2})) // want `byte slice converted to a string for io\.WriteString; use Write`
	return err
}
