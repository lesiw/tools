package a

func f(xs []int) bool {
	return len(xs) < 0 // want `len is never negative; this is always false`
}

func g(xs []int) bool {
	return len(xs) >= 0 // want `len is never negative; this is always true`
}

func h(xs []int) bool {
	return 0 > len(xs) // want `len is never negative; this is always false`
}

func i(xs []int) bool {
	return 0 <= len(xs) // want `len is never negative; this is always true`
}

func ok(xs []int) bool {
	return len(xs) == 0
}

func ok2(xs []int) bool {
	return len(xs) > 0
}
