package a

import (
	"fmt"
	"log"
	"testing"
)

func prints(n int) {
	fmt.Print(fmt.Sprintf("%d", n))         // want `use fmt.Printf`
	fmt.Println(fmt.Sprintf("%d", n))       // want `use fmt.Printf with the newline`
	fmt.Fprint(nil, fmt.Sprintf("%d", n))   // want `use fmt.Fprintf`
	fmt.Fprintln(nil, fmt.Sprintf("%d", n)) // want `use fmt.Fprintf`
}

func sprintln(n int) string {
	return fmt.Sprintln(fmt.Sprintf("%d", n)) // want `use fmt.Sprintf`
}

func held(n int) {
	format := "%d"
	fmt.Print(fmt.Sprintf(format, n))   // want `use fmt.Printf`
	fmt.Println(fmt.Sprintf(format, n)) // want `use fmt.Printf`
	log.Println(fmt.Sprintf(format, n)) // want `use log.Printf`
}

func raw(n int) {
	fmt.Println(fmt.Sprintf(`%d`, n))   // want `use fmt.Printf`
	fmt.Println(fmt.Sprintf("%d\n", n)) // want `use fmt.Printf`
}

func parenthesized(n int) {
	fmt.Print((fmt.Sprintf("%d", n))) // want `use fmt.Printf`
}

func spread(args []any) {
	fmt.Println(fmt.Sprintf("%d", args...)) // want `use fmt.Printf`
}

func annotated(n int) {
	fmt.Print(fmt.Sprintf( /* verb */ "%d", n))   // want `use fmt.Printf`
	fmt.Println(fmt.Sprintf("%d", n /* count */)) // want `use fmt.Printf`
}

func recorded(t *testing.T, b *testing.B, f *testing.F, tb testing.TB, n int) {
	t.Error(fmt.Sprintf("%d", n))  // want `use t.Errorf with the newline`
	t.Fatal(fmt.Sprintf("%d", n))  // want `use t.Fatalf`
	t.Log(fmt.Sprintf("%d", n))    // want `use t.Logf`
	t.Skip(fmt.Sprintf("%d", n))   // want `use t.Skipf`
	b.Error(fmt.Sprintf("%d", n))  // want `use b.Errorf`
	b.Fatal(fmt.Sprintf("%d", n))  // want `use b.Fatalf`
	b.Log(fmt.Sprintf("%d", n))    // want `use b.Logf`
	b.Skip(fmt.Sprintf("%d", n))   // want `use b.Skipf`
	tb.Error(fmt.Sprintf("%d", n)) // want `use tb.Errorf`
	tb.Fatal(fmt.Sprintf("%d", n)) // want `use tb.Fatalf`
	tb.Log(fmt.Sprintf("%d", n))   // want `use tb.Logf`
	tb.Skip(fmt.Sprintf("%d", n))  // want `use tb.Skipf`
	f.Log(fmt.Sprintf("%d", n))    // want `use f.Logf`
	f.Skip(fmt.Sprintf("%d", n))   // want `use f.Skipf`
	t.Log(fmt.Sprintf("%d\n", n))  // want `use t.Logf`
}

type promoted struct{ *testing.T }

type ownErrorf struct{ *testing.T }

func (ownErrorf) Errorf() {}

type ownError struct{ *testing.T }

func (ownError) Error(string, ...any) {}

type throughTB struct{ testing.TB }

func embedded(e1 promoted, e2 ownErrorf, e3 ownError, e4 throughTB, n int) {
	e1.Error(fmt.Sprintf("%d", n)) // want `use e1.Errorf`
	e1.Fatal(fmt.Sprintf("%d", n)) // want `use e1.Fatalf`
	e2.Error(fmt.Sprintf("%d", n))
	e2.Fatal(fmt.Sprintf("%d", n)) // want `use e2.Fatalf`
	e3.Error(fmt.Sprintf("%d", n))
	e3.Fatal(fmt.Sprintf("%d", n)) // want `use e3.Fatalf`
	e4.Error(fmt.Sprintf("%d", n)) // want `use e4.Errorf`
	e4.Fatal(fmt.Sprintf("%d", n)) // want `use e4.Fatalf`
}

type embeddedLog struct{ *log.Logger }

func loggedEmbed(e embeddedLog, n int) {
	e.Println(fmt.Sprintf("%d", n)) // want `use e.Printf with the newline`
}

func malformed(n int) {
	fmt.Println(fmt.Sprintf("%d", n, n)) // want `use fmt.Printf with the newline`
	fmt.Println(fmt.Sprintf("%d%", n))   // want `use fmt.Printf with the newline`
}

func logged(l *log.Logger, n int) {
	log.Print(fmt.Sprintf("%d", n))   // want `use log.Printf`
	log.Println(fmt.Sprintf("%d", n)) // want `use log.Printf`
	log.Fatal(fmt.Sprintf("%d", n))   // want `use log.Fatalf`
	log.Fatalln(fmt.Sprintf("%d", n)) // want `use log.Fatalf`
	log.Panic(fmt.Sprintf("%d", n))   // want `use log.Panicf`
	log.Panicln(fmt.Sprintf("%d", n)) // want `use log.Panicf`
	l.Print(fmt.Sprintf("%d", n))     // want `use l.Printf`
	l.Println(fmt.Sprintf("%d", n))   // want `use l.Printf`
	l.Fatal(fmt.Sprintf("%d", n))     // want `use l.Fatalf`
	l.Fatalln(fmt.Sprintf("%d", n))   // want `use l.Fatalf`
	l.Panic(fmt.Sprintf("%d", n))     // want `use l.Panicf`
	l.Panicln(fmt.Sprintf("%d", n))   // want `use l.Panicf`
}

type recorder struct{}

func (recorder) Error(...any)          {}
func (recorder) Errorf(string, ...any) {}

func alone(r recorder, n int, s string) {
	r.Error(fmt.Sprintf("%d", n))
	fmt.Printf("%d", n)
	fmt.Println(n)
	fmt.Errorf("%d", n)
	fmt.Sprint(s)
	fmt.Printf("%s", fmt.Sprintf("%d", n))
	fmt.Print(fmt.Sprintf("%d", n), "x")
	fmt.Fprintln(nil, fmt.Sprintf("%d", n), "x")
}

func message() (string, []any) { return "%d", []any{1} }

func multiValue() {
	fmt.Print(fmt.Sprintf(message()))       // want `use fmt.Printf`
	fmt.Fprint(nil, fmt.Sprintf(message())) // want `use fmt.Fprintf`
	fmt.Println(fmt.Sprintf(message()))     // want `use fmt.Printf`
}

func Sprintf(s string) string { return s }

func shadowedSprintf(format string) {
	fmt.Print(Sprintf(format))
}

func methodExpression(t *testing.T, n int) {
	(*testing.T).Error(t, fmt.Sprintf("%d", n)) // want `Errorf`
}
