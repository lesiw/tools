package a

func take(any) {}

func run(f func()) { f() }

func recoverOutside() {
	recover() // want `recover outside a deferred function has no effect`
}

func callRecoverOutside() {
	recoverOutside()
}

func recoverInLiteral() {
	defer func() {
		recover()
	}()
}

func recoverParenLiteral() {
	defer (func() {
		recover()
	})()
}

func recoverNested() {
	defer func() {
		func() {
			recover() // want `recover outside a deferred function has no effect`
		}()
	}()
}

func recoverInNestedDeferArgument() {
	defer func() {
		defer take(recover())
	}()
}

func deferRecover() {
	defer recover() // want `recover is the deferred call; call it directly in a deferred function`
}

func callDeferRecover() {
	deferRecover()
}

func deferParenRecover() {
	defer (recover)() // want `recover is the deferred call; call it directly in a deferred function`
}

func callDeferParenRecover() {
	deferParenRecover()
}

func deferArgument() {
	defer take(recover()) // want `recover runs when the defer is registered; call it inside the deferred function`
}

func callDeferArgument() {
	deferArgument()
}

func deferRecoverInLiteral() {
	defer func() {
		defer recover() // want `recover is the deferred call; call it directly in a deferred function`
	}()
}

func deferRecoverInNamedHelper() {
	defer recover() // want `recover is the deferred call; call it directly in a deferred function`
}

func callDeferredRecoverHelper() {
