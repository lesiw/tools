func slice(xs []int) {
	// want +1 `nil check around range is unnecessary`
	if xs != nil {
		for _, x := range xs {
			use(x)
		}
	}
}

func mapping(m map[string]int) {
	// want +1 `nil check around range is unnecessary`
	if m != nil {
		for k, v := range m {
			use(k, v)
		}
	}
}

func fill(m map[string]int) {
	// want +1 `nil check around range is unnecessary`
	if m != nil {
		for k := range m {
			m[k]++
		}
	}
}

