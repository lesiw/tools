	if err = deeper(err); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func namesLast(name string) error {
	var other, err error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return other
}

func specComment(name string) error {
	var err /* holds it */, other error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return other
}

func rangeOnly(names map[string]error, name string) error {
	for _, err := range names {
		if err = fetch(name); err != nil { // want `in this if statement`
			return err
		}
	}
	return nil
}

func aboveComment(name string) error {
	// err holds the result.
	var err error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func concrete(name string) (err error) {
	if err = typed(name); err != nil {
		return err
	}
	return nil
}

func assignedLater(name string) (err error) {
	defer func() {
		if err = fetch(name); err != nil { // want `in this if statement`
			_ = err
		}
	}()
	return nil
}

func constant(x float64) int {
	if x = 1; x > 0 {
		return 1
	}
	return 0
}

func added(n int) int {
	if n += 1; n > 2 {
		return n
	}
	return 0
}

func naked(name string) (err error) {
	if err = fetch(name); err != nil {
		return err
	}
	return
}

func literalStatement(name string) (err error) {
	f := func() {
		if err = fetch(name); err != nil { // want `in this if statement`
			_ = err
		}
	}
	f()
	return nil
}

func deferred(name string) (err error) {
	if err = fetch(name); err != nil {
		defer func() { _ = err }()
	}
	return nil
}

func addressed(name string) (err error) {
	if err = fetch(name); err != nil {
		p := &(err)
		return *p
	}
	return nil
}

func readBefore(name string) error {
	err := fetch(name)
	if err != nil {
		return err
	}
	if err = fetch(name); err != nil {
		return err
	}
	return nil
}

func readAfter(name string) error {
	var err error
	if err = fetch(name); err != nil {
		return err
	}
	return err
}

func writtenBefore(name string) (err error) {
	err = fetch(name)
	if err = fetch(name); err != nil {
		return err
	}
	return nil
}

func writtenAfter(name string) (err error) {
	if err = fetch(name); err != nil {
		return err
	}
	err = nil
	return nil
}

func neverRead(name string) (err error) {
	if err = fetch(name); name == "" {
		return nil
	}
	return nil
}

func writeOnly(name string) (err error) {
	if err = fetch(name); name == "" {
		err = nil
	}
	return nil
}

func rangeWrite(name string, errs map[string]error) (err error) {
	if err = fetch(name); name == "" {
		for _, err = range errs {
		}
	}
	return nil
}

func negate(n int) int {
	if n = -n; n > 0 { // want `in this if statement`
		return n
	}
	return 0
}

func field(it item) bool {
	if it.name = "x"; it.name == "" {
		return true
	}
	return false
}

func forInit(name string) (err error) {
	for err = fetch(name); err != nil; { // want `in this for statement`
		return nil
	}
	return nil
}

var err error

func global(name string) error {
	if err = fetch(name); err != nil {
		return err
	}
	return nil
}

func declared(name string) error {
	if err := fetch(name); err != nil {
		return err
	}
	return nil
}

func pair(name string) error {
	var n int
	var err error
	if n, err = len(name), fetch(name); err != nil && n > 0 {
		return err
	}
	return nil
}

func bound(v any, n string) (err error) {
	switch err = fetch(n); x := v.(type) { // want `in this switch statement`
	case int:
		_, _ = x, err
	}
	return nil
}
