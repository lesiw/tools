func chained(name string) error {
	var err error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	} else if err = deeper(err); err != nil {
		return err
	}
	return nil
}

func trailingAbove(name string) error {
	n := 1 // one
	var other error
	if other = fetch(name); other != nil { // want `in this if statement`
		return other
	}
	_ = n
	return nil
}

func belowBlank(name string) error {
	var (
		n   int
		err error

		m int
	)
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	_, _ = n, m
	return nil
}

func spaced(name string) error {
	var (
		n int // count

		err error
	)
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	_ = n
	return nil
}

func middleName(name string) error {
	var first, err, last error
	if err = fetch(name); err != nil { // want `in this if statement`
		first = err
		return err
	}
	_, _ = first, last
	return nil
}

func trailingComment(name string) error {
	var other, err error               // err holds it
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return other
}

func aboveName(name string) error {
	// both come from f.
	var other, err error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return other
}

func atLimit(name string) (err error) {
	if err = fetch(name); len(name) > 10000000 { // want `in this if statement`
		return err
	}
	return nil
}

func overLimit(name string) (err error) {
	if err = fetch(name); len(name) > 10000000 && len(name) < 20000000 && len(name) != 5 { // want `in this if statement`
		return err
	}
	return nil
}

func nestedRange(name string, names map[error]string) (err error) {
	if err = fetch(name); name != "" {
		for err = range names {
		}
	}
	return nil
}

