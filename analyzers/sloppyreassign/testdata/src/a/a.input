package a

func trim(s string) string { return s }

func fetch(name string) error       { return nil }
func deeper(err error) error        { return err }
func typed(name string) *namedError { return nil }

type namedError struct{}

func (e *namedError) Error() string { return "some message" }

type item struct {
	name string
}

func namedResult(name string) (err error) {
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func selfRead(name string) (err error) {
	if err = deeper(err); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func literal(name string) {
	f := func() (err error) {
		if err = fetch(name); err != nil { // want `in this if statement`
			return err
		}
		return nil
	}
	_ = f
}

func nestedNaked(name string) (err error) {
	f := func() (n int) {
		return
	}
	_ = f
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func passThrough(name string, err error) error {
	if err = deeper(err); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func compound(name string) (n int) {
	if n = len(name); name == "" { // want `in this if statement`
		n += 1
	}
	return 0
}

func loop(names map[string]bool) {
	for name := range names {
		if name = trim(name); name != "" { // want `in this if statement`
			delete(names, name)
		}
	}
}

func tagless(name string) (err error) {
	switch err = fetch(name); { // want `in this switch statement`
	case err != nil:
		return err
	}
	return nil
}

func tagged(name string) (err error) {
	switch err = fetch(name); err { // want `in this switch statement`
	case nil:
		return nil
	default:
		return err
	}
}

func typeSwitch(v any, name string) (err error) {
	switch err = fetch(name); v.(type) { // want `in this switch statement`
	case int:
		return err
	}
	return nil
}

func parameter(name string, err error) error {
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func (it item) receiver(name string) bool {
	if it = (item{name}); it.name == "" { // want `in this if statement`
		return true
	}
	return false
}

func local(name string) error {
	var err error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func shortDecl(name string) error {
	n, err := len(name), error(nil)
	_ = n
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func sharedVar(name string) error {
	var err, other error
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return other
}

func withValue(name string) error {
	var err = deeper(nil)
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func commentedDecl(name string) error {
	var err error                      // holds the result
	if err = fetch(name); err != nil { // want `in this if statement`
		return err
	}
	return nil
}

func grouped(name string) error {
