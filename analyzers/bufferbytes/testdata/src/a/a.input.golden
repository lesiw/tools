const nothing = ""

func blankNamed(buf *bytes.Buffer) bool {
	return (*buf).String() == nothing // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func blankLeft(buf *bytes.Buffer) bool {
	return "" == (*buf).String() // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func shadowedLen(buf *bytes.Buffer) int {
	len := func(string) int { return 0 }
	return len((*buf).String()) // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func textValueReceiverComment(buf bytes.Buffer) string {
	return (buf /* keep */).String() // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func textValuePrefixComment(buf bytes.Buffer) string {
	return string( /* keep */ buf.Bytes()) // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
