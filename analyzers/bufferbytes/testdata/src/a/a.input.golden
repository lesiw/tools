func blankShadowed(buf *bytes.Buffer) bool {
	len := func(string) int { return 0 }
	_ = len
	return (*buf).String() == "" // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func unblankShadowed(buf *bytes.Buffer) bool {
	len := func(string) int { return 0 }
	_ = len
	return (*buf).String() != "" // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
