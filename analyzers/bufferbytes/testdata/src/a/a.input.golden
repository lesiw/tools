func same(s string) string { return s }

func nestedIndex(m map[string]int, buf *bytes.Buffer) int {
	return m[same((*buf).String())] // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func substringIndex(m map[byte]int, buf *bytes.Buffer) int {
	return m[(*buf).String()[0]] // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

