func text(buf *bytes.Buffer) string {
	return (*buf).String() // want `conversion of Bytes to a string; String returns it for a non-nil buffer`
}

func data(buf *bytes.Buffer) []byte {
	return []byte(buf.String()) // want `conversion of String to a byte slice; Bytes aliases the buffer`
}

