}

func compositeValue() item {
	return item(item{}) // want `unnecessary conversion`
}

func switchTag() {
	switch item(item{}) { // want `unnecessary conversion`
	}
}

func switchComparison(v item) {
	switch v == item(item{}) { // want `unnecessary conversion`
	}
}

func rangeHeader() {
	for range bytesAlias(bytesAlias{}) { // want `unnecessary conversion`
	}
}

func ifInit(v item) {
	if w := item(item{}); w.N == v.N { // want `unnecessary conversion`
	}
}

func switchPointer() {
	switch (*item)(&item{}) { // want `unnecessary conversion`
	}
}

func switchMethod() {
	switch item(item{}.copy()) { // want `unnecessary conversion`
	}
}

func rangeSlice() {
	for range bytesAlias(bytesAlias{}[0:]) { // want `unnecessary conversion`
	}
}

func product(a, b, c int) int {
	return int(a+b) * c // want `unnecessary conversion`
}

func difference(a, b, c int) int {
	return c - int(a+b) // want `unnecessary conversion`
}

func quotient(a, b, c int) int {
	return c * int(a/b) // want `unnecessary conversion`
}

func sumRight(a, b, c int) int {
	return c + int(a+b) // want `unnecessary conversion`
}

func unary(n int) int {
	return -int(-n) // want `unnecessary conversion`
}

func index(xs []int, a, b int) int {
	return xs[int(a+b)] // want `unnecessary conversion`
}

func stringIndex(s, t string) byte {
	return string(s + t)[0] // want `unnecessary conversion`
}

func selector(v item) int {
	return item(v).N // want `unnecessary conversion`
}

func callResult(f func(int) int, n int) int {
	return (func(int) int)(f)(n) // want `unnecessary conversion`
}

func useItem(item) bool { return true }

func callHeader() {
	if useItem(item(item{})) { // want `unnecessary conversion`
	}
}

func assignment(n int) {
	var m int
	m = int(n) // want `unnecessary conversion`
	_ = m
}

