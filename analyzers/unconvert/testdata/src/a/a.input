	return []int{int(n)} // want `unnecessary conversion`
}

func keyed(n int) map[int]int {
	return map[int]int{int(n): 1} // want `unnecessary conversion`
}

const (
	untypedNumber = 1
	typedNumber   = int(1)
)

func genericInt[T ~int](v T) T {
	return T(v) // want `unnecessary conversion`
}

func shift(u uint) int {
	return int(1 << u)
}

func shiftAssign(u uint) int64 {
	x := int64(1 << u)
	return x
}

func constantShift() int {
	return int(1 << 2)
}

func intShiftSum(u uint) int {
	return int((1 << u) + 1)
}

func runeShift(u uint) rune {
	return rune('a' << u)
}

func wideShift(u uint) uint64 {
	return uint64(1 << u)
}

func wideShiftSum(u uint) uint64 {
	return uint64((1 << u) + 1)
}

func intRuneShift(u uint) int {
	return int('a' << u)
}

func shiftTyped(u uint, n int64) int64 {
	return int64((1 << u) + n) // want `unnecessary conversion`
}

func runeTyped(u uint, n int) rune {
	return rune((1 << u) + n + 'a')
}

func runeTypedLeft(u uint, n int) rune {
	return rune(('a' << u) + n)
}

func comparison(n int) bool {
	return bool(n == 0)
}

