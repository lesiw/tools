package a

type count int

type number = int

type bytesAlias = []byte

type item struct{ N int }

func (i item) copy() item { return i }

type meters float64

func sameInt(n int) int {
	return int(n) // want `unnecessary conversion`
}

func sameBytes(b []byte) []byte {
	return []byte(b) // want `unnecessary conversion`
}

func sameBytesAlias(b []byte) []byte {
	return bytesAlias(b) // want `unnecessary conversion`
}

func sameString(s string) string {
	return string(s) // want `unnecessary conversion`
}

func sameNamed(c count) count {
	return count(c) // want `unnecessary conversion`
}

