func conjunction(left, right *record, ok bool) bool {
	return reflect.DeepEqual(left, right) && ok // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
}

func conditional(left, right *record) bool {
	if reflect.DeepEqual(left, &record{}) { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
		return true
	}
	return false
}

func conditionalRight(left, right *record) bool {
	switch reflect.DeepEqual(&record{}, right) { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
	case true:
		return true
	}
	return false
}

func conditionalAnd(left, right *record, ok bool) bool {
	if ok && reflect.DeepEqual(left, &record{}) { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
		return true
	}
	return false
}

func conditionalPlain(left, right *record) bool {
	if reflect.DeepEqual(left, right) { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
		return true
	}
	return false
}

func conditionalFor(left, right *record) bool {
	for reflect.DeepEqual(left, &record{}) { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
