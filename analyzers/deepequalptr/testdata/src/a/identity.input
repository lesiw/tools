type zeroHolder struct {
	values [0]*int
}

type zeroGenericHolder[T any] struct {
	values [0]T
}

type zeroUncomparableHolder struct {
	values [0][]int
}

type version struct {
	major int
	minor int
}

func (v version) Equal(other version) bool { return v.major == other.major }

type versionPtr struct {
	major int
}

func (v *versionPtr) Equal(other versionPtr) bool { return v.major == other.major }

type oddEqual struct {
	count int
}

func (oddEqual) Equal(other string) bool { return false }

type versionRef struct {
	major int
}

func (v *versionRef) Equal(other *versionRef) bool { return v.major == other.major }

type nonBooleanEqual struct {
	count int
}

func (nonBooleanEqual) Equal(other nonBooleanEqual) int { return 0 }

type twoParameterEqual struct {
	count int
}

func (twoParameterEqual) Equal(left, right twoParameterEqual) bool {
	return left.count == right.count
}

type noResultEqual struct {
	count int
}

func (noResultEqual) Equal(other noResultEqual) {}

type pointerParam struct {
	count int
}

func (pointerParam) Equal(other *pointerParam) bool { return false }

type innerEqual struct{}

type outerEqual struct {
	innerEqual
	count int
}

func (innerEqual) Equal(other outerEqual) bool { return true }

type innerEqualOther struct{}

type outerEqualOther struct {
	innerEqualOther
	count int
}

func (innerEqualOther) Equal(other innerEqualOther) bool { return true }

