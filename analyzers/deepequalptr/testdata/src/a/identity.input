func conditionalInit(left, right *record) bool {
	if same := reflect.DeepEqual(left, &record{}); same { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
		return true
	}
	return false
}

func conditionalSwitchInit(left, right *record) bool {
	switch same := reflect.DeepEqual(left, &record{}); same { // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
	case true:
		return true
	}
	return false
}

func guardLeft(left, right *record, ok bool) bool {
	return reflect.DeepEqual(left, right) == ok // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
}

func guardRight(left, right *record, ok bool) bool {
	return ok == reflect.DeepEqual(left, right) // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
}

func guardNotEqual(left, right *record, ok bool) bool {
	return reflect.DeepEqual(left, right) != ok // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
}

func commented(left, right *record) bool {
	return reflect.DeepEqual( /* note */ left, right) // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
}

func multiline(left *record) bool { // want +1 `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
	return reflect.DeepEqual(left, func() *record {
		return nil
	}())
}

func splitCall(left, right *record) bool {
	return reflect.DeepEqual( // want `reflect\.DeepEqual on two pointers compares what they point to; compare the pointers`
		left, right)
}

