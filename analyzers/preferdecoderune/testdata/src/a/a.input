func instantiated(s string) rune {
	return box[rune](s)[0] // want `string converted to a rune slice; use utf8.DecodeRuneInString`
}

func targetParam[S ~[]rune](s string) rune {
	return S(s)[0] // want `string converted to a rune slice; use utf8.DecodeRuneInString`
