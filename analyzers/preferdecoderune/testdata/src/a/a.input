	return ([]rune(s))[0] // want `string converted to a rune slice; use utf8.DecodeRuneInString`
}

func parenthesizedType(s string) rune {
	return ([]rune)(s)[0] // want `string converted to a rune slice; use utf8.DecodeRuneInString`
}

type name string

