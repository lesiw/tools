const zero = 0

func namedIndex(s string) bool {
	return []rune(s)[zero] == 'x' // want `string converted to a rune slice; use utf8.DecodeRuneInString`
}

func int32s(s string) rune {
	return []int32(s)[0] // want `string converted to a rune slice; use utf8.DecodeRuneInString`
}

