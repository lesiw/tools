	if err != nil {
		panic(err)
	}
	defer f.Close()
}

func stdClose() {
	defer os.Stdout.Close() // want `deferred Close discards its error`
	defer os.Stderr.Close() // want `deferred Close discards its error`
	defer os.Stdin.Close()
}

func fmtClose(f *os.File) {
