var nameFile = "name"

type writer struct{}

func (*writer) Write(p []byte) (int, error) { return len(p), nil }

func (*writer) Close() error { return nil }

type quietWriter struct{}

func (*quietWriter) Write(p []byte) (int, error) { return len(p), nil }

func (*quietWriter) Close() {}

type flusherOnly struct{}

func (*flusherOnly) Flush() error { return nil }

type quietFlusher struct{}

func (*quietFlusher) Flush() {}

type reader struct{}

