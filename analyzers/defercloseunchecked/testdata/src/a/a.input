}

func shadowPanic(cond bool, f *os.File, p []byte) {
	panic := func(string) {}
	if cond {
		f.Write(p)
		panic("stop")
	}
	defer f.Close() // want `deferred Close discards its error`
}

func immediateLiteralWrite(f *os.File, p []byte) {
	func() { f.Write(p) }()
	defer f.Close() // want `deferred Close discards its error`
}

func goexitAfterDefer(cond bool, f *os.File, p []byte) {
	defer f.Close() // want `deferred Close discards its error`
	if cond {
		f.Write(p)
		runtime.Goexit()
	}
}

func exitAfterWrite(f *os.File, p []byte) {
	defer f.Close()
	f.Write(p)
	os.Exit(0)
}

func deferReturnThenWrite(cond bool, f *os.File, p []byte) {
	if cond {
		defer f.Close()
		return
	}
	f.Write(p)
}

func goWriteAfterDefer(f *os.File, p []byte) {
	defer f.Close()
	go f.Write(p)
}

func breakBeforeDefer(cond bool, f *os.File, p []byte) {
	for {
		if cond {
			f.Write(p)
			break
		}
		defer f.Close()
		return
	}
}

func deferredLiteralWrite(f *os.File, p []byte) {
	defer f.Close() // want `deferred Close discards its error`
	defer func() { f.Write(p) }()
}

type addressWriter struct{}

func (addressWriter) Close() error { return nil }

func (*addressWriter) Write(p []byte) (int, error) { return len(p), nil }

func (*addressWriter) Flush() error { return nil }

func addressValue(w addressWriter) {
	defer w.Close() // want `deferred Close discards its error`
}

func addressNonAddressable() {
	defer makeAddress().Close()
}

func makeAddress() addressWriter { return addressWriter{} }
