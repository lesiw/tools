func fallthroughWrite(n int, f *os.File, p []byte) {
	switch n {
	case 1:
		f.Write(p)
		fallthrough
	case 2:
		defer f.Close() // want `deferred Close discards its error`
	}
}

func typeSwitchSibling(v any, f *os.File, p []byte) {
	switch v.(type) {
	case int:
		f.Write(p)
	case string:
		defer f.Close()
	}
}

func netConnClose(c net.Conn, p []byte) {
	c.Write(p)
	defer c.Close()
}

func pipeWriterClose(w *io.PipeWriter, p []byte) {
