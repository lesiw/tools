	f, _ := os.Create(name)
	var c any = f
	g := c.(*os.File)
	defer g.Close() // want `deferred Close discards its error`
}

func addrCreate(name string) {
	f, _ := os.Create(name)
	g := &f
	defer (*g).Close() // want `deferred Close discards its error`
}

func aliasWriteOriginal(f *os.File, p []byte) {
	g := f
