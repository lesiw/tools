	defer f.Close()
}

func rangeHeaderReplace(files []*os.File) {
	f, _ := os.Create(nameFile)
	for _, f = range files {
		_ = f
	}
	defer f.Close()
}

func rangeHeaderThenWrite(files []*os.File, p []byte) {
	f, _ := os.Create(nameFile)
	for _, f = range files {
		_ = f
	}
	f.Write(p)
	defer f.Close() // want `deferred Close discards its error`
}

func helperWrite(name string, p []byte) {
	f := helperCreate(name)
	f.Write(p)
	defer f.Close() // want `deferred Close discards its error`
}

func branchWriteOther(cond bool, f *os.File, p []byte) {
	if cond {
		f.Write(p)
	} else {
		defer f.Close()
	}
}

func branchReturnWrite(cond bool, f *os.File, p []byte) {
	if cond {
		f.Write(p)
		return
	}
	defer f.Close()
}

func conditionalWrite(cond bool, f *os.File, p []byte) {
	if cond {
		f.Write(p)
	}
	defer f.Close() // want `deferred Close discards its error`
}

func pipeClose(p []byte) {
	r, w, _ := os.Pipe()
	w.Write(p)
	defer w.Close()
	defer r.Close()
}

func deferredWrite(f *os.File, p []byte) {
	defer f.Write(p)
