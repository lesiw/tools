	f, _ := os.Open(name)
	defer fileEmbed{f}.Close()
	defer (&fileEmbed{f}).Close()
}

func literalReceiverCreate(name string) {
	f, _ := os.Create(name)
	defer fileEmbed{f}.Close() // want `deferred Close discards its error`
	defer (&fileEmbed{f}).Close() // want `deferred Close discards its error`
