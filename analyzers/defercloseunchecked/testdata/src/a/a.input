func fallthroughSibling(n int, f *os.File, p []byte) {
	switch n {
	case 1:
		f.Write(p)
		fallthrough
	case 2:
		f.Write(p)
	case 3:
		defer f.Close()
	}
}

func logPanicWrite(cond bool, f *os.File, p []byte) {
	if cond {
		f.Write(p)
		log.Panic("stop")
