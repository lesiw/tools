type namedWriter struct{}

func (*namedWriter) Write(p []byte) (int, error) { return len(p), nil }

func (*namedWriter) Close() *closeError { return nil }

type twoResults struct{}

func (*twoResults) Write(p []byte) (int, error) { return len(p), nil }

func (*twoResults) Close() (int, error) { return 0, nil }

type embedded struct{ *writer }

type fieldCloser struct{ Close func() error }

func (*fieldCloser) Write(p []byte) (int, error) { return len(p), nil }

