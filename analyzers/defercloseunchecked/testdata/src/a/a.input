	defer w.Close()
}

func pointerOnValue(w pointerWriter) {
	defer w.Close()
}

func nonAddressable() {
	defer makeHalf().Close()
}

func makeHalf() halfPointer { return halfPointer{} }

func interfaceClose(w io.WriteCloser) {
	defer w.Close()
}

func genericClose[T closerWriter](w T) {
	defer w.Close()
}

func genericCloser[T closer](c T) {
	defer c.Close()
