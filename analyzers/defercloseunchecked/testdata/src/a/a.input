const (
	openWrite  = os.O_WRONLY | os.O_CREATE
	openAppend = os.O_APPEND
)

func constFlagsWrite(name string) {
	f, _ := os.OpenFile(name, openWrite, 0o600)
	defer f.Close() // want `deferred Close discards its error`
}

func constFlagsAppend(name string) {
	f, _ := os.OpenFile(name, openAppend, 0o600)
	defer f.Close()
}

func reassignRead(name, other string) {
	f, _ := os.Open(name)
	defer f.Close()
	f, _ = os.Create(other)
}

func reassignWrite(name, other string) {
	f, _ := os.Create(name)
	defer f.Close() // want `deferred Close discards its error`
	f, _ = os.Open(other)
}

func reassignAfterWrite(name, other string, p []byte) {
	f, _ := os.Open(name)
	f.Write(p)
	f, _ = os.Open(other)
	defer f.Close()
}

func helperOpen(name string) (*os.File, error) {
	return os.Open(name)
}

func reassignHelper(name string) {
	f, err := os.Create(name)
	if err != nil {
		panic(err)
	}
	f, err = helperOpen(name)
	if err != nil {
		panic(err)
	}
	defer f.Close()
}

func writeAfterDefer(f *os.File, p []byte) {
	defer f.Close() // want `deferred Close discards its error`
	f.Write(p)
}

func reassignBeforeLaterWrite(f, g *os.File, p []byte) {
	defer f.Close()
	f = g
	f.Write(p)
}

func branchReadThenWrite(cond bool, name, other string) {
	var f *os.File
	if cond {
		f, _ = os.Open(name)
	} else {
		f, _ = os.Create(other)
	}
	defer f.Close()
}

func branchWriteThenRead(cond bool, name, other string) {
	var f *os.File
	if cond {
		f, _ = os.Create(name)
	} else {
		f, _ = os.Open(other)
	}
	defer f.Close()
}

func derefOpen(name string) {
	f, _ := os.Open(name)
	defer (*f).Close()
}

func derefCreate(name string) {
	f, _ := os.Create(name)
	defer (*f).Close() // want `deferred Close discards its error`
}

func aliasAfterWrite(f *os.File, p []byte) {
	f.Write(p)
	g := f
	defer g.Close()
}

func sequentialReassign(name, other string) {
	f, _ := os.Open(name)
	f, _ = os.Create(other)
	defer f.Close() // want `deferred Close discards its error`
}

func variableFlagsWrite(name string, flags int, p []byte) {
	f, _ := os.OpenFile(name, flags, 0o600)
