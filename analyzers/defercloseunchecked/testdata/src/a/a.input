func branchThenWrite(cond bool, name, other string, p []byte) {
	var f *os.File
	if cond {
		f, _ = os.Open(name)
	} else {
		f, _ = os.Create(other)
	}
	f.Write(p)
	defer f.Close() // want `deferred Close discards its error`
}

func createInBranch(cond bool, name string) {
	if cond {
		f, _ := os.Create(name)
		defer f.Close() // want `deferred Close discards its error`
	}
}

func forOrigin(name string) {
	var f *os.File
	for i := 0; i < 1; i++ {
		f, _ = os.Open(name)
	}
	defer f.Close()
}

func rangeOrigin(files []*os.File) {
	var f *os.File
	for _, g := range files {
		f = g
	}
	defer f.Close()
}

func caseOrigin(n int, name string) {
	var f *os.File
	switch n {
	case 1:
		f, _ = os.Open(name)
	default:
		f, _ = os.Create(name)
	}
	defer f.Close()
}

func caseThenWrite(n int, name string, p []byte) {
	var f *os.File
	switch n {
	case 1:
		f, _ = os.Open(name)
	default:
		f, _ = os.Create(name)
	}
	f.Write(p)
	defer f.Close() // want `deferred Close discards its error`
}

func commOrigin(ch chan *os.File) {
	var f *os.File
	select {
	case f = <-ch:
	}
	defer f.Close()
}

func swapReadWrite(f, g *os.File) {
	var read, write *os.File
	read, _ = os.Open(nameFile)
	write, _ = os.Create(nameFile)
	f, g = write, read
	defer f.Close() // want `deferred Close discards its error`
	defer g.Close()
}

func swapWriteRead(f, g *os.File) {
	var read, write *os.File
	read, _ = os.Open(nameFile)
	write, _ = os.Create(nameFile)
	f, g = read, write
	defer f.Close()
	defer g.Close() // want `deferred Close discards its error`
}

func loopPost(name string) {
	var f *os.File
	for i := 0; i < 1; f, _ = os.Create(name) {
		defer f.Close()
		_ = i
	}
}

func loopPostAfter(name string) {
	var f *os.File
	for i := 0; i < 1; f, _ = os.Create(name) {
		_ = i
	}
	defer f.Close()
}

