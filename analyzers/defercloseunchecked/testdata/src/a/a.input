func (*lower) flush() error { return nil }

type other struct{}

func (*other) Shutdown() error { return nil }

type closer interface{ Close() error }

type closerWriter interface{ io.WriteCloser }

func fileClose(f *os.File, p []byte) {
	f.Write(p)
	defer f.Close() // want `deferred Close discards its error`
}

func readOnlyClose(name string) {
	f, err := os.Open(name)
	if err != nil {
		panic(err)
	}
	defer f.Close()
}

func createClose(name string) {
	f, err := os.Create(name)
	if err != nil {
		panic(err)
	}
	defer f.Close() // want `deferred Close discards its error`
}

func tempClose() {
