}

func aliasAfterReturningWrite(cond bool, f *os.File, p []byte) {
	if cond {
		f.Write(p)
		return
	}
	g := f
	defer g.Close()
}

func writeThenConditionalReassign(cond bool, name, other string, p []byte) {
	f, _ := os.Create(name)
	f.Write(p)
	if cond {
		f, _ = os.Open(other)
	}
	defer f.Close() // want `deferred Close discards its error`
}

func breakCaseWrite(n int, f *os.File, p []byte) {
	switch n {
	case 1:
		f.Write(p)
		break
	}
	defer f.Close()
}

func continueLoopWrite(f *os.File, p []byte) {
	for i := 0; i < 1; i++ {
		f.Write(p)
		continue
	}
	defer f.Close() // want `deferred Close discards its error`
}

type wrappingClose struct{ *os.File }

func (wrappingClose) Close() error { return nil }

func wrapperOverride(f *os.File) {
	w := wrappingClose{f}
	defer w.Close()
}

func deferredWriteBeforeClose(f *os.File, p []byte) {
	defer f.Close() // want `deferred Close discards its error`
	defer f.Write(p)
}

func deferredArgumentWrite(f *os.File, p []byte) {
	defer f.Close() // want `deferred Close discards its error`
	defer fmt.Fprintln(f, p)
}

func deferInBranchWriteOutside(cond bool, f *os.File, p []byte) {
	if cond {
		defer f.Close() // want `deferred Close discards its error`
	}
	f.Write(p)
}

func writeBeforeConditionalDefer(cond bool, f *os.File, p []byte) {
	f.Write(p)
	if cond {
		defer f.Close() // want `deferred Close discards its error`
	}
}

func siblingDeferredWrite(cond bool, f *os.File, p []byte) {
	if cond {
		defer f.Close()
	} else {
		defer f.Write(p)
	}
}

func writableReadCloser(name string) {
	f, _ := os.Create(name)
	var body io.ReadCloser = f
	defer body.Close() // want `deferred Close discards its error`
}

func panicWrite(cond bool, f *os.File, p []byte) {
	if cond {
		f.Write(p)
		panic("stop")
	}
	defer f.Close()
}

type stringFile struct{ *os.File }

func (*stringFile) Write(s string) error { return nil }

func (*stringFile) WriteString(s string) (string, error) { return s, nil }

func stringFileWrite(f *os.File) {
	w := stringFile{f}
	w.WriteString("x")
	defer w.Close()
}

func switchSiblingWrite(n int, f *os.File, p []byte) {
	switch n {
	case 1:
		f.Write(p)
	case 2:
		defer f.Close()
	}
}

func selectSiblingDefer(ch chan int, f *os.File, p []byte) {
	select {
	case <-ch:
		defer f.Close()
	default:
		defer f.Write(p)
	}
}

func exitAfterDefer(cond bool, f *os.File, p []byte) {
	defer f.Close()
	if cond {
		f.Write(p)
		os.Exit(0)
	}
}

func fatalAfterDefer(cond bool, f *os.File, p []byte) {
	defer f.Close()
	if cond {
		f.Write(p)
		log.Fatal("stop")
	}
}

