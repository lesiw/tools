package a

import (
	"fmt"
	"log"
	"os"
	"testing"
)

func literals(s string) []string {
	return []string{
		fmt.Sprintf("%q", s),                 // want `format string quotes a %s; use %q`
		fmt.Sprintf(`%q`, s),                   // want `format string quotes a %s; use %q`
		fmt.Sprintf("%q", s),             // want `format string quotes a %s; use %q`
		fmt.Sprintf("%q", s),         // want `format string quotes a %s; use %q`
		fmt.Sprintf(("%q"), s),               // want `format string quotes a %s; use %q`
		fmt.Sprintf(`the name %q is taken`, s), // want `format string quotes a %s; use %q`
		fmt.Sprintf("\u00e9 %q", s),          // want `format string quotes a %s; use %q`
		fmt.Sprintf("100%% %q", s),           // want `format string quotes a %s; use %q`
	}
}

type label string

func typed(l label, b []byte, sum [32]byte, n int, v any) []string {
	return []string{
		fmt.Sprintf("%q", l),   // want `format string quotes a %s; use %q`
		fmt.Sprintf("%q", b),   // want `format string quotes a %s; use %q`
		fmt.Sprintf("%q", sum), // want `format string quotes a %s; use %q`
		fmt.Sprintf("\"%s\"", n),
		fmt.Sprintf("\"%s\"", v),
	}
}

func wrapped(s string) error {
	return fmt.Errorf("%q", s) // want `format string quotes a %s; use %q`
}

func printed(s string) {
	fmt.Printf("%q", s)             // want `format string quotes a %s; use %q`
	fmt.Fprintf(os.Stdout, "%q", s) // want `format string quotes a %s; use %q`
	fmt.Appendf(nil, "%q", s)       // want `format string quotes a %s; use %q`
}

func logged(s string) {
	log.Printf("%q", s) // want `format string quotes a %s; use %q`
	log.Fatalf("%q", s) // want `format string quotes a %s; use %q`
	log.Panicf("%q", s) // want `format string quotes a %s; use %q`
}

func loggedFrom(l *log.Logger, s string) {
	l.Printf("%q", s) // want `format string quotes a %s; use %q`
}

func failed(t *testing.T, tb testing.TB, s string) {
	t.Errorf("%q", s)  // want `format string quotes a %s; use %q`
	t.Fatalf("%q", s)  // want `format string quotes a %s; use %q`
	t.Logf("%q", s)    // want `format string quotes a %s; use %q`
	t.Skipf("%q", s)   // want `format string quotes a %s; use %q`
	tb.Errorf("%q", s) // want `format string quotes a %s; use %q`
}

func verbs(s string, n int) []string {
	return []string{
		fmt.Sprintf("%s", s),
		fmt.Sprintf("%q", s),
		fmt.Sprintf("`%s`", s),
		fmt.Sprintf("%d: \"%s\"", n, s),
		fmt.Sprintf("\"%s\" \"%s\"", s, s),
		fmt.Sprintf("\"%s", s),
		fmt.Sprintf("%s\"", s),
		fmt.Sprintf("\"%v\"", s),
	}
}

func modifiers(w int, s string) []string {
	return []string{
		fmt.Sprintf("\"%*s\"", w, s),
		fmt.Sprintf("\"%5s\"", s),
		fmt.Sprintf("\"%.2s\"", s),
		fmt.Sprintf("\"%[1]s\"", s),
	}
}

func attributes(s string) []string {
	return []string{
		fmt.Sprintf("mode=\"%s\"", s),
		fmt.Sprintf("mode = \"%s\"", s),
		fmt.Sprintf("mode=\t\"%s\"", s),
		fmt.Sprintf("mode: %q", s), // want `format string quotes a %s; use %q`
	}
}

func formatVariable(format, s string) string {
	return fmt.Sprintf(format, s)
}

const format = "\"%s\""

func formatConstant(s string) string {
	return fmt.Sprintf(format, s)
}

func noValue() string {
	return fmt.Sprintf("\"%s\"")
}

func spread(parts []any) string {
	return fmt.Sprintf("\"%s\"", parts...)
}

func throughValue(s string) string {
	sprintf := fmt.Sprintf
	return sprintf("\"%s\"", s)
}

type printer struct{}

func (printer) Sprintf(string, ...any) string { return "" }

func shadowedMethod(p printer, s string) string {
	return p.Sprintf("\"%s\"", s)
}

type styled string

func (styled) Format(fmt.State, rune) {}

type pointerStyled string

func (*pointerStyled) Format(fmt.State, rune) {}

func formatMethod(f styled, p pointerStyled) []string {
	return []string{
		fmt.Sprintf("\"%s\"", f),
		fmt.Sprintf("%q", p), // want `format string quotes a %s; use %q`
	}
}

func parameterized[T ~string](v T) string {
	return fmt.Sprintf("\"%s\"", v)
}
