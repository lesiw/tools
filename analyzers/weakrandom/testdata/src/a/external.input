package a

import (
	"b"
	"context"
	"fmt"
	"math/rand"
	"os"
	"sync"
)

func external(ctx context.Context) {
	context.WithValue(ctx, fmt.Sprint(rand.Intn(100)), "value")
	os.Getenv(fmt.Sprint(rand.Intn(100)))
	var m sync.Map
	m.Store(fmt.Sprint(rand.Intn(100)), "value")
	b.SetKey(rand.Intn(100))
}
