package a

import "time"

type When = time.Time

func unset(t time.Time) bool {
	return t == time.Time{} // want `compared with the zero value`
}

func set(t time.Time) bool {
	return t != time.Time{} // want `compared with the zero value`
}

func zeroLeft(t time.Time) bool {
	return time.Time{} == t // want `compared with the zero value`
}

func zeroLeftNot(t time.Time) bool {
	return time.Time{} != t // want `compared with the zero value`
}

func aliased(t When) bool {
	return t == When{} // want `compared with the zero value`
}

func parens(t time.Time) bool {
	return (t) == (time.Time{}) // want `compared with the zero value`
}

func notUnset(t time.Time) bool {
	return !(t == time.Time{}) // want `compared with the zero value`
}

func notSet(t time.Time) bool {
	return !(t != time.Time{}) // want `compared with the zero value`
}

func deref(p *time.Time) bool {
	return *p == time.Time{} // want `compared with the zero value`
}

func received(ch chan time.Time) bool {
	return <-ch != time.Time{} // want `compared with the zero value`
}

func field(item struct{ At time.Time }) bool {
	return item.At == time.Time{} // want `compared with the zero value`
}

func picked() time.Time {
	return time.Time{}
}

func called() bool {
	return picked() == time.Time{} // want `compared with the zero value`
}

func conjunction(t time.Time) bool {
	return t != time.Time{} && t.After(t) // want `compared with the zero value`
}

func commented(t time.Time) bool {
	return t == /* note */ time.Time{} // want `compared with the zero value`
}

func split(t time.Time) bool {
	return t == // want `compared with the zero value`
		time.Time{}
}

func multiline() bool {
	return func() time.Time { // want `^time\.Time compared with the zero value$`
		return time.Time{}
	}() == time.Time{}
}

type flag bool

func named(t time.Time) flag {
	return t == time.Time{} // want `compared with the zero value`
}

type alias = bool

func aliasedFlag(t time.Time) alias {
	return t == time.Time{} // want `compared with the zero value`
}

type Defined time.Time

func (d Defined) IsZero() bool { return time.Time(d).IsZero() }

func defined(d Defined) bool {
	return d == Defined{}
}

func composite(d time.Duration) bool {
	if (time.Time{}.Add(d)) == (time.Time{}) { // want `compared with the zero value`
		return true
	}
	return false
}

func neither() bool {
	return time.Time{} == time.Time{}
}

func compared(t, u time.Time) bool {
	return (t == time.Time{}) == // want `compared with the zero value`
		(u == time.Time{}) // want `compared with the zero value`
}

func comparedToFlag(t time.Time, set bool) bool {
	return (t == time.Time{}) == set // want `compared with the zero value`
}

func two(t, u time.Time) bool {
	return t == u
}

func zeroVariable(t, zero time.Time) bool {
	return t == zero
}

func switched(t time.Time) bool {
	switch t {
	case time.Time{}:
		return true
	}
	return false
}

func keyed(m map[time.Time]bool) bool {
	return m[time.Time{}]
}
