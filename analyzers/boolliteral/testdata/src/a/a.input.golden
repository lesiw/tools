func underLimit(conditionWithAnExcessivelyLongNameThatNearlyFillsTheLineNow bool) bool {
	// want +1 `write the operand negated$`
	return !conditionWithAnExcessivelyLongNameThatNearlyFillsTheLineNow
}

func joined(conditionWithAnExcessivelyLongNameThatNearlyFillsTheWholeLineAndThenXX bool) bool {
