package a

type flag bool

type other bool

func agrees(b bool) bool {
	if b { // want `write the operand$`
		return true
	}
	return b // want `write the operand$`
}

func inverts(b bool) bool {
	if !b { // want `write the operand negated$`
		return true
	}
	return !b // want `write the operand negated$`
}

func literalFirst(b bool) bool {
	if b { // want `write the operand$`
		return true
	}
	if b { // want `write the operand$`
		return true
	}
	if !b { // want `write the operand negated$`
		return true
	}
	return !b // want `write the operand negated$`
}

func parenthesized(b bool) bool {
	if b { // want `write the operand$`
		return true
	}
	return !(b) // want `write the operand negated$`
}

func namedCondition(f flag) bool {
	if f == true {
		return true
	}
	return false
}

func namedValue(f flag) flag {
	return f // want `write the operand$`
}

func namedInvert(f flag) flag {
	return !f // want `write the operand negated$`
}

func namedToBool(f flag) bool {
