}

type alias = bool

func aliasCondition(a alias) bool {
	if a { // want `write the operand$`
		return true
	}
	return false
}

func shadowedFalse(ok bool) bool {
	false := ok
	return ok == false
}

func generic[T ~bool](v T) bool {
	return v == true
}

func genericCondition[T ~bool](v T) bool {
	if v != false {
		return true
	}
	return false
}

func mixedNamed(a flag, b other) bool {
	return (a == true) && (b == true)
}

type boolOnly interface {
	~bool
}

type comparableOnly interface {
	comparable
}

func embeddedConstraint[T interface{ boolOnly; comparableOnly }](v T) bool {
	return v == true
}

func takesBool(bool) bool { return true }

func manyBool(...bool) bool { return true }

func contexts(b bool) {
	for b { // want `write the operand$`
		break
	}
	switch b {
	case b: // want `write the operand$`
	}
	var x = b // want `write the operand$`
	y := b    // want `write the operand$`
	var z bool
	z = b            // want `write the operand$`
	_ = takesBool(b) // want `write the operand$`
	_ = manyBool(b)  // want `write the operand$`
	_ = bool(b)      // want `write the operand$`
	ch := make(chan bool, 1)
	ch <- b              // want `write the operand$`
	var anyValue any = b // want `write the operand$`
	_ = []bool{b}        // want `write the operand$`
	_ = !(b)             // want `write the operand$`
	_ = x
	_ = y
	_ = z
	_ = anyValue
}

