func panicGuard(ok bool) {
	if !ok {
		panic("not ok")
	}
	panicGuard(ok)
}

func logFatalGuard(msg string) {
	if msg != "" {
		log.Fatal(msg)
	}
	logFatalGuard(msg)
}

func exitGuard(n int) {
	if n < 0 {
		os.Exit(1)
	}
	exitGuard(n)
}

func goexitGuard(n int) {
	if n < 0 {
		runtime.Goexit()
	}
	goexitGuard(n)
}

func tFatalGuard(t *testing.T, n int) {
	if n < 0 {
		t.Fatal("negative")
	}
	tFatalGuard(t, n-1)
}

func tFailNowGuard(t *testing.T, n int) {
	if n < 0 {
		t.FailNow()
	}
	tFailNowGuard(t, n-1)
}

func tSkipGuard(t *testing.T, n int) {
	if n < 0 {
		t.Skip("negative")
	}
	tSkipGuard(t, n-1)
}

func tbFatalGuard(tb testing.TB, n int) {
	if n < 0 {
		tb.Fatal("negative")
	}
	tbFatalGuard(tb, n-1)
}

func logPanicGuard(msg string) {
	if msg != "" {
		log.Panic(msg)
	}
	logPanicGuard(msg)
}

func logFatalfGuard(format string) {
	if format != "" {
		log.Fatalf("%s", format)
	}
	logFatalfGuard(format)
}

func tSkipfGuard(t *testing.T, n int) {
	if n < 0 {
		t.Skipf("n=%d", n)
	}
	tSkipfGuard(t, n-1)
}

func brokeInLoop(n int) {
	for {
		if n <= 0 {
			break
		}
		brokeInLoop(n - 1)
	}
}

func continuedInLoop(n int) {
	for {
		if n > 0 {
			continue
		}
		continuedInLoop(n)
	}
}

func continuedFromSwitch(n int) {
	for {
		switch n {
		case 1:
			continue
		}
		continuedFromSwitch(n)
	}
}

func continuedFromSelect(ch chan int, n int) {
	for {
		select {
		case <-ch:
			continue
		}
		continuedFromSelect(ch, n)
	}
}

func returnInLoop(n int) {
	for i := 0; i < n; i++ {
		if i > 5 {
			return
		}
	}
	returnInLoop(n)
}

func returnedFromSwitch(n int) int {
	switch {
	case n > 0:
		return n
	}
	return returnedFromSwitch(n)
}

func returnedFromSelect(ch chan bool) {
	select {
	case <-ch:
		return
	}
	returnedFromSelect(ch)
}

func ping() { pong() }

func pong() { ping() }
