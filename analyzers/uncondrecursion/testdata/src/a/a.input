func exitedByHelper(err error) {
	if err != nil {
		mustFail(err)
	}
	exitedByHelper(err) // want `unconditional recursive call`
}

func mustFail(error) { os.Exit(1) }

func labeledElsewhere(n int, xs []int) {
outer:
	for range xs {
		for range xs {
			if n > 0 {
				break outer
			}
		}
	}
	labeledElsewhere(n, xs)
}

