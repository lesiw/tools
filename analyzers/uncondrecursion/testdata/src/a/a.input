func labeledBreak(n int) {
walk:
	for {
		if n > 0 {
			break walk
		}
		labeledBreak(n)
	}
}

func brokeOuter(n int, xs []int) {
outer:
	for {
		for range xs {
			if n > 0 {
				break outer
			}
		}
		brokeOuter(n, xs)
	}
}

func continuedOuter(n int, xs []int) {
outer:
	for {
		for range xs {
			if n > 0 {
				continue outer
			}
		}
		continuedOuter(n, xs)
	}
}

func loopedByGoto(n int) {
again:
	if n > 0 {
		goto again
	}
	loopedByGoto(n)
}

func jumpedOver(n int) {
	goto end
	jumpedOver(n)
end:
	return
}

func skippedByGoto(n int, ok bool) {
	if ok {
		goto done
	}
	skippedByGoto(n, ok)
done:
}

func deadAfterPanic() {
	panic("stop")
	deadAfterPanic()
