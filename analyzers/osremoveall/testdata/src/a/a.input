}

func formatted(dir string) {
	os.RemoveAll(fmt.Sprintf("%s/", dir))
}

func converted(dir string) {
	os.RemoveAll(string(dir))
}

func guarded(dir string) {
	if dir == "" || filepath.Clean(dir) == "/" {
		return
	}
	os.RemoveAll(dir + "/")
}

func guardedBody(dir string) {
	if dir != "" && filepath.Clean(dir) != "/" {
		os.RemoveAll(dir + "/")
	}
}

func guardedElse(dir string) {
	if dir == "" || filepath.Clean(dir) == "/" {
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(dir + "/")
	} else {
		os.RemoveAll(dir + "/")
	}
}

func guardedLength(dir string) {
	if len(dir) == 0 || filepath.Clean(dir) == "/" {
		return
	}
	os.RemoveAll(dir + "/")
}

func guardedClean(dir string) {
	if filepath.Clean(dir) == "/" || dir == "" {
		return
	}
	os.RemoveAll(dir + "/")
}

func guardedPositiveLength(dir string) {
	if len(dir) > 0 && filepath.Clean(dir) != "/" {
		os.RemoveAll(dir + "/")
	}
}

func guardedPathClean(dir string) {
	if path.Clean(dir) == "/" || dir == "" {
		return
	}
	os.RemoveAll(dir + "/")
}

func normalized(dir string) {
	if dir == "" {
		dir = "cache"
	} else if filepath.Clean(dir) == "/" {
		dir = "cache"
	}
	os.RemoveAll(dir + "/")
}

func guardedPath(dir string) {
	if filepath.Clean(dir+"/") == "/" {
		return
	}
	os.RemoveAll(dir + "/")
}

func switchCases(dir string) {
	switch {
	case dir == "":
		return
	case filepath.Clean(dir) == "/":
		return
	}
	os.RemoveAll(dir + "/")
}

func switchBreak(dir string) {
	switch {
	case dir == "":
		break
	case filepath.Clean(dir) == "/":
		break
	}
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

func switchTrue(dir string) {
	switch {
	case dir != "" && filepath.Clean(dir) != "/":
		os.RemoveAll(dir + "/")
	}
}

func guardedNested(dir string) {
	if filepath.Clean(dir) != "/" {
		if dir != "" {
			os.RemoveAll(dir + "/")
		}
	}
}

func guardedPanic(dir string) {
	if dir == "" || filepath.Clean(dir) == "/" {
		panic("empty directory")
	}
	os.RemoveAll(dir + "/")
}

func nonEmptyOnly(dir string) {
	if dir == "" {
		return
	}
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

func rootOnly(dir string) {
