func reset(dir *string) { *dir = "/" }

func pointer(dir string) {
	dir = "cache"
	reset(&dir)
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

func value() string { return "" }

func getGuard() {
	if value() != "" && filepath.Clean(value()) != "/" {
		os.RemoveAll(value() + "/")
	}
}

func cleanConstant() {
	os.RemoveAll(filepath.Clean("/tmp") + "/")
}

func guardedJoin(dir string) {
	if filepath.Clean(filepath.Join(dir, "/")) == "/" {
		return
	}
	os.RemoveAll(filepath.Join(dir, "/"))
}

func guardedField(c *config) {
	if c.dir != "" && filepath.Clean(c.dir) != "/" {
		os.RemoveAll(c.dir + "/")
	}
}

func guardedIndex(a [1]string) {
	if a[0] != "" && filepath.Clean(a[0]) != "/" {
		os.RemoveAll(a[0] + "/")
	}
}

func joinedNames(dir, name string) {
