func aggregate() {
	a := [1]string{"cache"}
	if a[0] != "" && filepath.Clean(a[0]) != "/" {
		a[0] = "/"
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(a[0] + "/")
	}
}

func immediate(dir string) {
	dir = "cache"
	func() { dir = "/" }()
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

func star(dir string) {
	dir = "cache"
	p := &dir
	*p = "/"
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

var global string

func mutate() { global = "/" }

func indirectGlobal() {
	global = "cache"
	if global != "" && filepath.Clean(global) != "/" {
		mutate()
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(global + "/")
	}
}

type config struct{ dir string }

func mutateField(c *config) { c.dir = "/" }

func indirectField(c *config) {
	c.dir = "cache"
	if c.dir != "" && filepath.Clean(c.dir) != "/" {
		mutateField(c)
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(c.dir + "/")
	}
}

func mutateValue() string {
	global = "/"
	return ""
}

func declEffect() {
	global = "cache"
	if global != "" && filepath.Clean(global) != "/" {
		value := mutateValue()
		_ = value
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(global + "/")
	}
}

func loopEffect() {
	global = "cache"
	if global != "" && filepath.Clean(global) != "/" {
		for i := 0; i < 1; i++ {
			mutate()
		}
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(global + "/")
	}
}

func closureCall(dir string) {
	dir = "cache"
	if dir != "" && filepath.Clean(dir) != "/" {
		write := func() { dir = "/" }
		write()
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(dir + "/")
	}
}

func switchDefault(dir string) {
	switch {
	case dir == "":
		return
	default:
		dir = "/"
	}
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

func switchBranches(dir string, kind int) {
	switch kind {
	case 0:
		dir = "cache"
	case 1:
		dir = "cache"
	default:
		dir = "cache"
	}
	os.RemoveAll(dir + "/")
}

func mutateDir(p *string) bool { *p = "/"; return true }

func andEffect(dir string) {
	dir = "cache"
	if dir != "" && filepath.Clean(dir) != "/" && mutateDir(&dir) {
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(dir + "/")
	}
}

func resetPtr(p *string) { *p = "/" }

func pointerCall(dir string) {
	dir = "cache"
	p := &dir
	if dir != "" && filepath.Clean(dir) != "/" {
		resetPtr(p)
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(dir + "/")
	}
}

func use(f func()) { f() }

func closureIndirect(dir string) {
	dir = "cache"
	f := func() { dir = "/" }
	if dir != "" && filepath.Clean(dir) != "/" {
		use(f)
		// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
		os.RemoveAll(dir + "/")
	}
}

