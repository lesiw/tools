func remove(dir string) {
	// want +1 `os.Remove path built from a variable may be the filesystem root`
	os.Remove(dir + "/")
}

func removeAll(dir string) {
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + "/")
}

func nested(dir, name string) {
	// want +1 `os.RemoveAll path built from a variable may be the filesystem root`
	os.RemoveAll(dir + name + "/")
}

func cache(dir string) {
	os.RemoveAll(dir + "/cache")
}

