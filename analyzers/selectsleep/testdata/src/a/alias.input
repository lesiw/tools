package a

import t "time"

func pauseAliasedThenWorks() {
	// want +1 `select with a single case that receives from time\.After; write t\.Sleep\(t\.Second\)$`
	select {
	case <-t.After(t.Second):
		use()
	}
}

func pauseAliased() {
	// want +1 `select with a single case that receives from time\.After; write t\.Sleep\(t\.Second\)$`
	select {
	case <-t.After(t.Second):
	}
}
