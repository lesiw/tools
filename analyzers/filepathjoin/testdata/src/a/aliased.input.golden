package a

import fp "path/filepath"

var _ = fp.Separator

func aliased(root, name string) string {
	// want +1 `path concatenated with a literal separator can be replaced by fp.Join`
	return fp.Join(root, name)
}

func flattened(root, sub, name string) string {
	// want +1 `path concatenated with a literal separator can be replaced by fp.Join`
	return fp.Join(root, sub, name)
}
