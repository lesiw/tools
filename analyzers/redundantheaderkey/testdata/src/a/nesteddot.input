package a

import . "net/http"

func nestedDot(h, inner headerAlias) {
	h.Set(CanonicalHeaderKey(inner.Get(CanonicalHeaderKey("some-key"))), "some-value") // want `http\.Header\.Set canonicalizes the key; http\.CanonicalHeaderKey is redundant` `http\.Header\.Get canonicalizes the key; http\.CanonicalHeaderKey is redundant`
}
