package a

import "net/http"

func nestedComment(h, inner http.Header) {
	h.Set(http.CanonicalHeaderKey(/* key */ inner.Get(http.CanonicalHeaderKey("some-key"))), "some-value") // want `http\.Header\.Set canonicalizes the key; http\.CanonicalHeaderKey is redundant` `http\.Header\.Get canonicalizes the key; http\.CanonicalHeaderKey is redundant`
}
