	*time.Timer
}

type outer struct {
	*inner
}

func outerDrain(o *outer) {
	// want +1 `a receive after Reset can take the new timer's value`
	o.Reset(time.Second)
}

func drainWithElse(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !t.Reset(time.Second) {
		<-t.C
	} else {
		use("active")
	}
}

func promotedDrain(w *embedded) {
	// want +1 `a receive after Reset can take the new timer's value`
	w.Reset(time.Second)
}

func assignedPointer(t, u *time.Timer) {
	var active bool
	active, *t = t.Reset(time.Second), *u
	if !active {
		<-t.C
	}
}

func siblingField(h *holder) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !h.timer.Reset(time.Second) {
		h.other = true
		<-h.timer.C
	}
}

func stopBefore(t *time.Timer) {
	if !t.Reset(time.Second) {
		t.Stop()
		<-t.C
	}
}

func resetBefore(t *time.Timer) {
	if !t.Reset(time.Second) {
		t.Reset(time.Hour)
		<-t.C
	}
}

func pairedStop(t *time.Timer) {
	active, stopped := t.Reset(time.Second), t.Stop()
	if !active {
		use(stopped)
		<-t.C
	}
}

func pairedStopInit(t *time.Timer) {
	if active, stopped := t.Reset(time.Second), t.Stop(); !active {
		use(stopped)
		<-t.C
	}
}

func embeddedWrite(w *embedded, u *time.Timer) {
	if !w.Reset(time.Second) {
		w.Timer = u
		<-w.Timer.C
	}
}

func compoundIndex(timers []*time.Timer, i, j int) {
	if !timers[i+1].Reset(time.Second) {
		i = j
		<-timers[i+1].C
	}
}

func promotedFieldWrite(o *outer, u *inner) {
	if !o.Timer.Reset(time.Second) {
		o.inner = u
		<-o.Timer.C
	}
}

func unrelatedEmbedded(o, p *outer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !o.Reset(time.Second) {
		p.Timer = nil
		<-o.C
	}
}

func initMentions(t *time.Timer) {
	active := t.Reset(time.Second)
	if use(active); !active {
		<-t.C
	}
}

func promotedFieldDeep(o *outer, u *time.Timer) {
	if !o.Reset(time.Second) {
		o.inner.Timer = u
		<-o.C
	}
}

func channelWrite(w *embedded, ch <-chan time.Time) {
	if !w.Reset(time.Second) {
		w.Timer.C = ch
		<-w.C
	}
}

func deepChannelWrite(o *outer, ch <-chan time.Time) {
	if !o.Reset(time.Second) {
		o.inner.Timer.C = ch
		<-o.C
	}
}

type indexer struct {
	i int
}

func selectorIndex(timers []*time.Timer, h *indexer, j int) {
	if !timers[h.i].Reset(time.Second) {
		h.i = j
		<-timers[h.i].C
	}
}

func use(any) {}

type custom struct {
	C <-chan time.Time
}

func (c *custom) Reset(time.Duration) bool { return false }

func otherType(c *custom) {
	if !c.Reset(time.Second) {
		<-c.C
	}
}
