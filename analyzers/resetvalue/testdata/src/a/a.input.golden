package a

import "time"

func drainStopped(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	t.Reset(time.Second)
}

func waitRunning(t *time.Timer) {
	if t.Reset(time.Second) {
		<-t.C
	}
}

func drainParenthesized(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	t.Reset(time.Second)
}

func drainElse(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if t.Reset(time.Second) {
		use("active")
	} else {
		<-t.C
	}
}

func waitElse(t *time.Timer) {
	if !t.Reset(time.Second) {
		use("stopped")
	} else {
		<-t.C
	}
}

func drainBodyMore(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !t.Reset(time.Second) {
		<-t.C
		use("drained")
	}
}

func drainInit(t *time.Timer) {
	if active := t.Reset(time.Second); !active { // want `a receive after Reset can take the new timer's value`
		<-t.C
	}
}

func waitInit(t *time.Timer) {
	if active := t.Reset(time.Second); active {
		<-t.C
	}
}

func drainLocal(t *time.Timer) {
	active := t.Reset(time.Second) // want `a receive after Reset can take the new timer's value`
	if !active {
		<-t.C
	}
}

func waitLocal(t *time.Timer) {
	active := t.Reset(time.Second)
	if active {
		<-t.C
	}
}

func swappedLocal(t, u *time.Timer) {
	var active bool
	active, t = t.Reset(time.Second), u
	if !active {
		<-t.C
	}
}

func localUsed(t *time.Timer) {
	active := t.Reset(time.Second)
	use(active)
}

func localReassigned(t *time.Timer) {
	active := t.Reset(time.Second)
	active = false
	if !active {
		<-t.C
	}
}

func otherChannel(t *time.Timer, ch chan time.Time) {
	if !t.Reset(time.Second) {
		<-ch
	}
}

func otherTimer(t, u *time.Timer) {
	if !t.Reset(time.Second) {
		<-u.C
	}
}

func combined(t *time.Timer, x bool) {
	if !t.Reset(time.Second) || x {
		<-t.C
	}
}

func loop(t *time.Timer) {
	for t.Reset(time.Second) {
		<-t.C
	}
}

func switchOn(t *time.Timer) {
	switch t.Reset(time.Second) {
	case true:
		<-t.C
	}
}

func discard(t *time.Timer) {
	_ = t.Reset(time.Second)
}

func bare(t *time.Timer) {
	t.Reset(time.Second)
}

func readForOther(t *time.Timer) {
	if t.Reset(time.Second) {
		use("active")
	}
}

func commented(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !t.Reset(time.Second) {
		// why
		<-t.C
	}
}

func funcLiteral(t *time.Timer) {
	if !t.Reset(time.Second) {
		f := func() { <-t.C }
		f()
	}
}

func methodValue(t *time.Timer) {
	f := t.Reset
	if !f(time.Second) {
		<-t.C
	}
}

func stop(t *time.Timer) {
	if !t.Stop() {
		<-t.C
	}
}

func elseIf(t *time.Timer, x bool) {
	if x {
		use("x")
	} else if !t.Reset(time.Second) { // want `a receive after Reset can take the new timer's value`
		<-t.C
	}
}

func localElse(t *time.Timer) {
	active := t.Reset(time.Second) // want `a receive after Reset can take the new timer's value`
	if active {
		use("active")
	} else {
		<-t.C
	}
}

func initElse(t *time.Timer) {
	if active := t.Reset(time.Second); active { // want `a receive after Reset can take the new timer's value`
		use("active")
	} else {
		<-t.C
	}
}

func swappedInit(t, u *time.Timer) {
	if t, active := u, t.Reset(time.Second); !active {
		<-t.C
	}
}

func selectDrain(t *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !t.Reset(time.Second) {
		select {
		case <-t.C:
		default:
		}
	}
}

func valueDrain(t time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	t.Reset(time.Second)
}

type holder struct {
	timer *time.Timer
	other bool
}

func fieldDrain(h *holder) {
	// want +1 `a receive after Reset can take the new timer's value`
	h.timer.Reset(time.Second)
}

type wrapper struct {
	*time.Timer
	C <-chan time.Time
}

func wrapperDrain(w *wrapper) {
	if !w.Reset(time.Second) {
		<-w.C
	}
}

func stopInit(t *time.Timer) {
	active := t.Reset(time.Second)
	if active = t.Stop(); !active {
		<-t.C
	}
}

func tickerChannel(t *time.Timer, ticker *time.Ticker) {
	if !t.Reset(time.Second) {
		<-ticker.C
	}
}

func unrelatedInit(t *time.Timer) {
	active := t.Reset(time.Second) // want `a receive after Reset can take the new timer's value`
	if x := 1; !active {
		use(x)
		<-t.C
	}
}

func elseIfLocal(t *time.Timer, x bool) {
	active := t.Reset(time.Second)
	if x {
		use("x")
	} else if !active {
		<-t.C
	}
}

func duplicateAssign(t *time.Timer) {
	var active bool
	active, active = t.Reset(time.Second), false
	if !active {
		<-t.C
	}
}

func labeled(t *time.Timer) {
	goto drain
drain: // want +1 `a receive after Reset can take the new timer's value`
	t.Reset(time.Second)
}

func labeledLocal(t *time.Timer) {
	active := t.Reset(time.Second) // want `a receive after Reset can take the new timer's value`
drain:
	if !active {
		<-t.C
	}
	goto drain
}

func assignedField(h, other *holder) {
	var active bool
	active, h = h.timer.Reset(time.Second), other
	if !active {
		<-h.timer.C
	}
}

func methodExpr(t *time.Timer) {
	if !(*time.Timer).Reset(t, time.Second) {
		<-t.C
	}
}

