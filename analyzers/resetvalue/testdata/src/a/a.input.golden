	var active = t.Reset(time.Second) // want `a receive after Reset can take the new timer's value`
	if !active {
		<-t.C
	}
}

func reassignedBranch(t, u *time.Timer) {
	if !t.Reset(time.Second) {
		t = u
		<-t.C
	}
}

func reassignedField(h, other *holder) {
	if !h.timer.Reset(time.Second) {
		h = other
		<-h.timer.C
	}
}

func assignedAfter(t, u *time.Timer) {
	// want +1 `a receive after Reset can take the new timer's value`
	if !t.Reset(time.Second) {
		<-t.C
		t = u
	}
}

func elseIfGate(t *time.Timer, x bool) {
	if t.Reset(time.Second) {
		use("active")
	} else if x {
		<-t.C
	}
}

func elseIfBoth(t *time.Timer) {
	if t.Reset(time.Second) {
		use("active")
	} else if !t.Reset(time.Second) { // want `a receive after Reset can take the new timer's value`
		<-t.C
	}
}

func reassignedIndex(timers []*time.Timer, i, j int) {
	if !timers[i].Reset(time.Second) {
		i = j
		<-timers[i].C
	}
}

func reassignedRange(timers []*time.Timer) {
	t := timers[0]
	if !t.Reset(time.Second) {
		for _, t = range timers {
		}
		<-t.C
	}
}

func initWritesTimer(t, u *time.Timer) {
	active := t.Reset(time.Second)
	if t = u; active {
		use("active")
	} else {
		<-t.C
	}
}

func initWritesTimerBody(t, u *time.Timer) {
	active := t.Reset(time.Second)
	if t = u; !active {
		<-t.C
	}
}

func duplicateAssignReset(t *time.Timer) {
	var active bool
	active, active = false, t.Reset(time.Second) // want `a receive after Reset can take the new timer's value`
	if !active {
		<-t.C
	}
}

