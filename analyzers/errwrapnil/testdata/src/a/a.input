type logger struct{}

func (logger) Errorf(string, ...any) error { return nil }

func method(l logger) error {
	return l.Errorf("fetch: %w", nil)
}

func functionValue() error {
	f := fmt.Errorf
	return f("fetch: %w", nil)
}

func multiline() error {
	return fmt.Errorf(
		"fetch: %w",
		nil) // want `fmt.Errorf has a nil %w operand`
}

func shadowed() error {
	fmt := logger{}
	return fmt.Errorf("fetch: %w", nil)
}

func commentedArgument() error {
	return fmt.Errorf(
		"fetch: %w", /* keep */
		nil,         // want `fmt.Errorf has a nil %w operand`
	)
}

func commentedFormat() error {
	return fmt.Errorf("fetch: " + /* keep */ "%w", nil) // want `fmt.Errorf has a nil %w operand`
}

func extraArgument() error {
