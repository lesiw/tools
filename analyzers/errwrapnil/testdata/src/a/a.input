}

func selectorConstant() error {
	return fmt.Errorf(b.Message, nil) // want `fmt.Errorf has a nil %w operand`
}

func concatenatedFormat() error {
	return fmt.Errorf("fetch: " + "%w", nil) // want `fmt.Errorf has a nil %w operand`
}

func nilForValue() error {
