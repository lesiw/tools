package a

func use(...any) {}

type holder struct {
	items map[string]int
}

func total(m map[string]int) {
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func whole(m map[string]int) {
	length := len(m)
	for range m {
		use(length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func field(h holder) {
	length := len(h.items)
	for k := range h.items {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func twice(m map[string]int) {
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
		use(length)    // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func labeled(m map[string]int) {
	length := len(m)
outer:
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
		break outer
	}
}

func branched(m map[string]int, ok bool) {
	length := len(m)
	for k := range m {
		if ok {
			use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
		}
	}
}

func trailing(m map[string]int) (n int) {
	n = 0 // running total
	length := len(m)
	for k := range m {
		n += len(k) + length // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	return n
}

func siblings(m, other map[string]int) {
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	length2 := len(other)
	for k := range other {
		use(k, length2) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func literal(m map[string]int) {
	func() {
		length := len(m)
		for k := range m {
			use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
		}
	}()
}

func condition(m map[string]int, out []string) []string {
	length := len(m)
	for k := range m {
		if length > cap(out) { // want `map length does not depend on the loop; evaluate it once before the loop`
			out = append(out, k)
		}
	}
	return out
}

func blanked(m map[string]int) {
	_ = m
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func consecutive(m map[string]int) {
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	length2 := len(m)
	for k := range m {
		use(k, length2) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func interrupted(m map[string]int) {
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	delete(m, "alpha")
	length2 := len(m)
	for k := range m {
		use(k, length2) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func hides(m map[string]int, verbose bool) {
	length2 := len(m)
	for k := range m {
		if verbose {
			length := 0
			use(length)
			use(k, length2) // want `map length does not depend on the loop; evaluate it once before the loop`
		}
	}
}

func later(m map[string]int) (n int) {
	length2 := len(m)
	for k := range m {
		n += len(k) + length2 // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	length := 0
	return n + length
}

func built(m map[string]int) (n int) {
	length := len(m)
	for k := range m {
		seen := make(map[string]int)
		seen[k] = 0
		n += length // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	return n
}

func cased(m map[string]int, n int) {
	switch n {
	case 1:
		length := len(m)
		for k := range m {
			use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
		}
	}
}

func generic[K comparable, V any](m map[K]V) {
	length := len(m)
	for k := range m {
		use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
	}
}

func selected(m map[string]int, ch chan int) {
	select {
	case <-ch:
		length := len(m)
		for k := range m {
			use(k, length) // want `map length does not depend on the loop; evaluate it once before the loop`
		}
	}
}

func three(m map[string]int) (n int) {
	length := len(m)
	for k := range m {
		n += len(k) + length // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	length2 := len(m)
	for k := range m {
		n += len(k) + length2 // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	length3 := len(m)
	for k := range m {
		n += len(k) + length3 // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	return n
}

func nested(m, n map[string]int) {
	length := len(m)
	for k := range m {
		length2 := len(n)
		for j := range n {
			use(k, j, length, length2) // want `map length does not depend on the loop; evaluate it once before the loop` `map length does not depend on the loop; evaluate it once before the loop`
		}
	}
}

func composite() (n int) {
	seen := map[string]int{}
	length := len(seen)
	for k := range seen {
		n += len(k) + length // want `map length does not depend on the loop; evaluate it once before the loop`
	}
	return n
}
