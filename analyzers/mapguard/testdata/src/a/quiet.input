func otherSum(total map[string]int, delta int) {
	if _, ok := total["alpha"]; ok {
		total["alpha"] += delta
	} else {
		total["alpha"] = 2
	}
}

func inverted(index map[string][]string, kind string) {
	if _, ok := index["alpha"]; !ok {
		index["alpha"] = append(index["alpha"], kind)
	} else {
		index["alpha"] = []string{kind}
	}
}

func moreStatements(index map[string][]string, kind string) {
	if _, ok := index["alpha"]; ok {
		index["alpha"] = append(index["alpha"], kind)
		index["beta"] = nil
	} else {
		index["alpha"] = []string{kind}
	}
}

func emptyAppend(index map[string][]string) {
	if _, ok := index["alpha"]; ok {
		index["alpha"] = append(index["alpha"])
	} else {
