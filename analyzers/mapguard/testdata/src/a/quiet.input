func channelKey(index map[int][]string, ch chan int, kind string) {
	if _, ok := index[len(ch)]; ok {
		index[len(ch)] = append(index[len(ch)], kind)
	} else {
		index[len(ch)] = []string{kind}
	}
}

func effectfulKey(index map[string][]string, kind string) {
	if _, ok := index[next()]; ok {
		index[next()] = append(index[next()], kind)
	} else {
		index[next()] = []string{kind}
	}
}

func assignedFlag(index map[string][]string, kind string, ok bool) {
