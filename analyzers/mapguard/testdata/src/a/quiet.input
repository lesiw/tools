package a

func differentValues(index map[string][]string, kind, other string) {
	if _, ok := index["alpha"]; ok {
		index["alpha"] = append(index["alpha"], kind)
	} else {
		index["alpha"] = []string{other}
	}
}

func differentKey(index map[string][]string, kind string) {
	if _, ok := index["alpha"]; ok {
		index["alpha"] = append(index["beta"], kind)
	} else {
		index["alpha"] = []string{kind}
	}
}

func differentMap(one, two map[string][]string, kind string) {
	if _, ok := one["alpha"]; ok {
		one["alpha"] = append(two["alpha"], kind)
	} else {
		one["alpha"] = []string{kind}
	}
}

func differentTarget(index, other map[string][]string, kind string) {
	if _, ok := index["alpha"]; ok {
		other["alpha"] = append(index["alpha"], kind)
	} else {
		other["alpha"] = []string{kind}
	}
}

func subtract(total map[string]int, delta int) {
	if _, ok := total["alpha"]; ok {
		total["alpha"] -= delta
	} else {
		total["alpha"] = delta
	}
}

func decrement(total map[string]int) {
	if _, ok := total["alpha"]; ok {
		total["alpha"]--
	} else {
		total["alpha"] = 0
	}
}

func notOne(total map[string]int) {
	if _, ok := total["alpha"]; ok {
		total["alpha"]++
	} else {
		total["alpha"] = 2
	}
}

func incrementedOther(total map[string]int) {
	if _, ok := total["alpha"]; ok {
		total["alpha"]++
	} else {
		total["beta"] = 1
	}
}

func eitherCondition(index map[string][]string, kind string, ready bool) {
	if _, ok := index["alpha"]; ok && ready {
		index["alpha"] = append(index["alpha"], kind)
	} else {
		index["alpha"] = []string{kind}
	}
}

func fewerValues(index map[string][]string, first, second string) {
