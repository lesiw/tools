package a

import (
	"errors"
	"net/http"
	"os"
)

type alphaError struct{ error }

type betaError struct {
	error
	count int
	nums  []int
	next  *betaError
}

func (betaError) Mark() {}

func touch[T any](v T) bool { return false }

func pick(err error) error { return err }

var (
	enabled = false
	plain   any
)

func chain(err error) {
	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
		_ = err
	}

	if perr, ok := errors.AsType[*os.PathError](err); ok {
		_ = perr
	} else if perr, ok := errors.AsType[*os.LinkError](perr); ok { // want `perr is the zero value of \*os.PathError from the earlier AsType call`
		_ = perr
	}

	if herr, ok := errors.AsType[*http.MaxBytesError](err); ok {
		_ = herr
	} else if herr, ok := errors.AsType[*http.ProtocolError](herr); ok { // want `herr is the zero value of \*http.MaxBytesError from the earlier AsType call`
		_ = herr
	}

	if alpha, ok := errors.AsType[*alphaError](err); ok {
		_ = alpha
	} else if beta, ok := errors.AsType[*betaError](err); ok {
		_ = beta
	}

	if alpha, ok := errors.AsType[*alphaError](err); ok {
		_ = alpha
	} else if beta, ok := errors.AsType[*betaError](alpha); ok { // want `alpha is the zero value of \*alphaError from the earlier AsType call`
		_ = beta
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok && enabled {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); !ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](pick(err)); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError]((err)); ok {
		_ = err
	}

	if _, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if enabled {
		_ = &err
	} else if err != nil {
		err = &alphaError{}
	} else if touch(err) {
		err = &alphaError{}
	} else if other := err; touch(&other) && touch(other) {
		err = &alphaError{}
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if touch((err)) {
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if touch(*err) {
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if len([]error{err}) > 0 {
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err.Error() != "" {
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	count := map[error]int{}
	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if count[err] != 0 {
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[interface {
		error
		Mark()
	}](err); ok {
		_ = err
	} else if found, ok := err.(*betaError); ok {
		_ = found
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of interface\{Mark\(\); error\} from the earlier AsType call`
		_ = err
	}

	if err, ok := errors.AsType[betaError](err); ok {
		_ = err
	} else if err.error == nil || err.count == 3 || len(err.nums) == 0 ||
		err.nums[1] == 3 {
	} else if err.next.nums[0] == 1 {
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of betaError from the earlier AsType call`
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
		_ = err
	} else if err, ok := errors.AsType[error](err); ok { // want `err is the zero value of \*betaError from the earlier AsType call`
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of error from the earlier AsType call`
		_ = err
	}
}

func reassigned(err error) {
	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok = errors.AsType[*alphaError](err); ok {
		_ = err
	}
}

func assigned(err error) {
	var (
		perr *os.PathError
		ok   bool
	)
	if perr, ok = errors.AsType[*os.PathError](err); ok {
		_ = perr
	} else if perr, ok = errors.AsType[*os.PathError](perr); ok {
		_ = perr
	}
}

func guarded(err error) {
	if err, ok := errors.AsType[*alphaError](err); enabled {
		_ = err
		_ = ok
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok && enabled {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if touch(&err) {
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if other := &err; touch(other) {
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}
}

func nested(err error) {
	if err, ok := errors.AsType[*alphaError](err); ok {
		err = &alphaError{}
	} else {
		_ = err
		if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
			_ = err
		}
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		err = &alphaError{}
	} else {
		err = &alphaError{}
		if err, ok := errors.AsType[*betaError](err); ok {
			_ = err
		}
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		if err, ok := errors.AsType[*betaError](err); ok {
			_ = err
		}
	} else if enabled {
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
		if inner, ok := errors.AsType[*betaError](err); ok {
			_ = inner
		}
	} else if enabled {
	} else {
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if enabled {
		if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
			_ = err
		}
	}

	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if enabled {
		if err, ok := errors.AsType[*betaError](err); ok {
			_ = err
		}
		err = &alphaError{}
	}
}

func other(err error) {
	if err, ok := errors.AsType[*alphaError](err); ok {
		_ = err
	} else if found, ok := plain.(error); ok {
		_ = found
	} else if err, ok := errors.AsType[*betaError](err); ok { // want `err is the zero value of \*alphaError from the earlier AsType call`
		_ = err
	}
}

func AsType[T any](error) (T, bool) {
	var zero T
	return zero, true
}

func named(err error) {
	if err, ok := AsType[*alphaError](err); ok {
		_ = err
	} else if err, ok := AsType[*betaError](err); ok {
		_ = err
	}
}

func madeUp[T any](error) (T, bool) {
	var zero T
	return zero, true
}

func notAsType(err error) {
	if err, ok := madeUp[*alphaError](err); ok {
		_ = err
	} else if err, ok := errors.AsType[*betaError](err); ok {
		_ = err
	}
}
