func use(...any) {}

func elseRead(x any) {
	if v, ok := x.(int); ok {
		use(v)
	} else {
		use(v) // want `v is the zero value in the branch where the type assertion fails`
	}
}

func notOK(x any) {
	if v, ok := x.(int); !ok {
		use(v) // want `v is the zero value in the branch where the type assertion fails`
	} else {
		use(x)
	}
}

func elseIfCondition(x any) {
	if v, ok := x.(int); ok {
		use(v)
	} else if v > 0 { // want `v is the zero value in the branch where the type assertion fails`
		use(x)
	}
}

func elseIfBody(x any) {
	if v, ok := x.(int); ok {
		use(v)
	} else if x != nil {
		use(v) // want `v is the zero value in the branch where the type assertion fails`
	}
}

