}

func fieldReadBeforeWrite(x any) {
	if v, ok := x.(record); ok {
		use(v)
	} else {
		use(v.n) // want `v is the zero value in the branch where the type assertion fails`
		v.n = 1
	}
}

func fieldWriteSometimes(x any, cond bool) {
	if v, ok := x.(record); ok {
		use(v)
	} else {
		if cond {
			v.n = 1
