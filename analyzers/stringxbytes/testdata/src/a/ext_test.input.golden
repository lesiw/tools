package a_test

import "a"

func writeOwn(r a.Relay, src string) (int, error) {
	return r.Write([]byte(src))
}

type mock struct{}

func (mock) Write(p []byte) (int, error) { return len(p), nil }

func (mock) WriteString(s string) (int, error) { return len(s), nil }

func exercise(m mock, src string) (int, error) {
	return m.Write([]byte(src))
}
