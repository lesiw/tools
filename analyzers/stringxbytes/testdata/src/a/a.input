type wire []byte

func (wire) Write(p []byte) (int, error) { return len(p), nil }

func (wire) WriteString(s string) (int, error) { return len(s), nil }

func methodExpression(a, b string) (int, error) {
	return wire.Write([]byte(a), []byte(b))
}

type delegating struct{}

func (delegating) Write(p []byte) (int, error) { return len(p), nil }

func (d delegating) WriteString(s string) (int, error) { return d.write(s) }

func (d delegating) write(s string) (int, error) {
	return d.Write([]byte(s))
}

type aside struct{}

func (*aside) Write(p []byte) (int, error) { return len(p), nil }

func (*aside) WriteString(s string) (int, error) {
	var a aside
	return a.Write([]byte(s))
}

type address struct{}

func (*address) Write(p []byte) (int, error) { return len(p), nil }

func (a *address) WriteString(s string) (int, error) { return a.write(s) }

func (a address) write(s string) (int, error) {
	return (&a).Write([]byte(s))
}

func parenthesizedCall(buf *bytes.Buffer, src string) (int, error) {
	return (buf.Write)([]byte(src)) // want `conversion only to call Write; WriteString takes a string`
}

func grown(src string) []byte { return []byte(src) }

func growCall(buf *bytes.Buffer, src string) (int, error) {
	return buf.Write(grown(src))
}

