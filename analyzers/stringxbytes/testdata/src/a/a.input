func (ledger) Record(p []byte) (int, error) { return len(p), nil }

func recorded(l ledger, src string) (int, error) {
	return l.Record([]byte(src))
}

type anyWrite struct{}

func (anyWrite) Write(v any) (int, error) { return 0, nil }

func (anyWrite) WriteString(s string) (int, error) { return len(s), nil }

