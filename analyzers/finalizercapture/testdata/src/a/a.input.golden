package a

import "runtime"

type item struct {
	label int
}

type holder struct {
	it *item
}

func use(...any) {}

func direct() {
	it := &item{}
	runtime.SetFinalizer(it, func(it *item) { // want `finalizer captures the object it finalizes, so the object may not be collected`
		use(it)
	})
}

func namedParameter() {
	it := &item{}
	runtime.SetFinalizer(it, func(v *item) { // want `finalizer captures the object it finalizes, so the object may not be collected`
		use(v)
		use(v)
	})
}

