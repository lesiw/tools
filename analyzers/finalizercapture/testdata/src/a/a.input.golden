func conditionalFinalizer(flag bool) {
	it := &item{}
	release := func(*item) { use(it) }
	if flag {
		release = func(*item) { use(it) }
	}
	runtime.SetFinalizer(it, release) // want `finalizer captures the object it finalizes, so the object may not be collected`
}

func loopMutation() {
	it := &item{}
	runtime.SetFinalizer(it, func(*item) { // want `finalizer captures the object it finalizes, so the object may not be collected`
		use(it)
	})
	for range 1 {
		it = &item{}
	}
}

