func cyclicFinalizer() {
	it := &item{}
	release := func(*item) { use(it) }
	for i := 0; i < 2; i++ {
		if i > 0 {
			release = release
		}
	}
	runtime.SetFinalizer(it, release) // want `finalizer captures the object it finalizes, so the object may not be collected`
}

