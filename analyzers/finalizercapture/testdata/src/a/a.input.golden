func twoBranchFinalizer(flag bool) {
	it := &item{}
	release := func(*item) { use(it) }
	go func() { use(release) }()
	if flag {
		release = func(v *item) { use(v) }
	} else {
		release = func(v *item) { use(v) }
	}
	runtime.SetFinalizer(it, release)
}

