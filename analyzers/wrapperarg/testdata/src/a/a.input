package a

import (
	"bytes"
	"image"
	"image/draw"
	"strings"
	"sync"
	"unicode"
)

func splitEvery(s, sep string) []string {
	return strings.SplitN(s, sep, -1) // want `strings\.SplitN with a negative count can be replaced by strings\.Split`
}

func splitEveryParenthesized(s, sep string) []string {
	return (strings.SplitN)(s, sep, (-1)) // want `strings\.SplitN with a negative count can be replaced by strings\.Split`
}

func splitMany(s, sep string) []string {
	return strings.SplitN(s, sep, -2) // want `strings\.SplitN with a negative count can be replaced by strings\.Split`
}

func splitEveryBytes(b, sep []byte) [][]byte {
	return bytes.SplitN(b, sep, -1) // want `bytes\.SplitN with a negative count can be replaced by bytes\.Split`
}

func splitAfterEvery(s, sep string) []string {
	return strings.SplitAfterN(s, sep, -1) // want `strings\.SplitAfterN with a negative count can be replaced by strings\.SplitAfter`
}

func splitAfterEveryBytes(b, sep []byte) [][]byte {
	return bytes.SplitAfterN(b, sep, -1) // want `bytes\.SplitAfterN with a negative count can be replaced by bytes\.SplitAfter`
}

func upperEvery(s string) string {
	return strings.Map(unicode.ToUpper, s) // want `strings\.Map with unicode\.ToUpper can be replaced by strings\.ToUpper`
}

func lowerEvery(s string) string {
	return strings.Map(unicode.ToLower, s) // want `strings\.Map with unicode\.ToLower can be replaced by strings\.ToLower`
}

func titleEvery(s string) string {
	return strings.Map(unicode.ToTitle, s) // want `strings\.Map with unicode\.ToTitle can be replaced by strings\.ToTitle`
}

func replacedEvery(b, old, new []byte) []byte {
	return bytes.Replace(b, old, new, -1) // want `bytes\.Replace with a negative count can be replaced by bytes\.ReplaceAll`
}

func upperEveryBytes(b []byte) []byte {
	return bytes.Map(unicode.ToUpper, b) // want `bytes\.Map with unicode\.ToUpper can be replaced by bytes\.ToUpper`
}

func lowerEveryBytes(b []byte) []byte {
	return bytes.Map(unicode.ToLower, b) // want `bytes\.Map with unicode\.ToLower can be replaced by bytes\.ToLower`
}

func titleEveryBytes(b []byte) []byte {
	return bytes.Map(unicode.ToTitle, b) // want `bytes\.Map with unicode\.ToTitle can be replaced by bytes\.ToTitle`
}

func countDown(wg *sync.WaitGroup) {
	wg.Add(-1) // want `WaitGroup\.Add with a delta of -1 can be replaced by WaitGroup\.Done`
}

func countDownComma(wg *sync.WaitGroup) {
	wg.Add(-1,) // want `WaitGroup\.Add with a delta of -1 can be replaced by WaitGroup\.Done`
}

func countDownMultiline(wg *sync.WaitGroup) {
	// want +1 `WaitGroup\.Add with a delta of -1 can be replaced by WaitGroup\.Done`
	wg.Add(
		-1,
	)
}

type wrapping struct{ bytes.Buffer }

func emptied(w wrapping) {
	w.Truncate(0) // want `Buffer\.Truncate with a length of 0 can be replaced by Buffer\.Reset`
}

func emptiedBuffer(buf *bytes.Buffer) {
	buf.Truncate(0) // want `Buffer\.Truncate with a length of 0 can be replaced by Buffer\.Reset`
}

func repaint(dst draw.Image, r image.Rectangle, src image.Image, sp image.Point) {
	draw.DrawMask(dst, r, src, sp, nil, image.Point{}, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
}

func repaintAt(dst draw.Image, r image.Rectangle, src image.Image, sp, mp image.Point) {
	draw.DrawMask(dst, r, src, sp, nil, mp, draw.Over) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
}

func repaintReused(dst draw.Image, r image.Rectangle, src image.Image, sp image.Point) {
	mp := image.Point{}
	draw.DrawMask(dst, r, src, sp, nil, mp, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
	usePoint(mp)
}

var origin image.Point

func repaintPackage(dst draw.Image, r image.Rectangle, src image.Image, sp image.Point) {
	draw.DrawMask(dst, r, src, sp, nil, origin, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
}

func repaintResult(dst draw.Image, r image.Rectangle, src image.Image, sp image.Point) (mp image.Point) {
	draw.DrawMask(dst, r, src, sp, nil, mp, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
	return
}

func repaintCommented(dst draw.Image, r image.Rectangle, src image.Image, sp, mp image.Point) {
	draw.DrawMask(dst, r, src, sp, nil /* kept */, mp, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
	draw.DrawMask(dst, r, src, sp, nil, mp, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
}

func repaintLiteral(dst draw.Image, r image.Rectangle, src image.Image, sp image.Point) {
	func(mp image.Point) {
		draw.DrawMask(dst, r, src, sp, nil, mp, draw.Src) // want `draw\.DrawMask with a nil mask can be replaced by draw\.Draw`
	}(image.Point{})
}

func usePoint(image.Point) {}
