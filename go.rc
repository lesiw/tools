test (
	go tool lesiw.io/tools/cmd/vet $GOARGS
	CGO_ENABLED=0 go test $GOARGS -shuffle=on -timeout=10s $GOFLAGS
	CGO_ENABLED=1 go test $GOARGS -shuffle=on -timeout=60s -race $GOFLAGS
)
vet go tool lesiw.io/tools/cmd/vet $GOARGS $GOFLAGS
fix go tool lesiw.io/tools/cmd/fix $GOARGS $GOFLAGS
clerk go tool lesiw.io/tools/cmd/clerk app
