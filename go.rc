test (
	go tool lesiw.io/tools/cmd/vet $GOARGS -importgroup.local=lesiw.io,labs.lesiw.io
	CGO_ENABLED=0 go test $GOARGS -shuffle=on -timeout=10s $GOFLAGS
	CGO_ENABLED=1 go test $GOARGS -shuffle=on -timeout=60s -race $GOFLAGS
)
vet go tool lesiw.io/tools/cmd/vet $GOARGS -importgroup.local=lesiw.io,labs.lesiw.io $GOFLAGS
fix go tool lesiw.io/tools/cmd/fix $GOARGS -importgroup.local=lesiw.io,labs.lesiw.io $GOFLAGS
clerk go tool lesiw.io/tools/cmd/clerk app
